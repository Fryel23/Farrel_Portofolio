---
/* src/components/layout/ReferenceDock.astro - Tiling Reference Dock (V13.0-D).
   Hanya aktif pada layar desktop (>= 1024px). Menggunakan <iframe sandbox="">
   tanpa izin script/navigasi-atas untuk menampilkan halaman referensi statis
   same-origin (/lab/methodology, ADR detail, Codex detail, /atlas) tanpa
   memindahkan <main> atau mengganggu kanvas aktif. */
---

<aside
  id="world-reference-dock"
  class="world-ref-dock"
  aria-label="Reference Workspace Split View"
  hidden
>
  <header class="world-ref-dock-header">
    <div class="world-ref-dock-meta">
      <span class="world-ref-dock-kicker">REFERENCE WORKSPACE</span>
      <h2 class="world-ref-dock-title" id="world-dock-title">
        /lab/methodology · ISPU P.14/2020 Methodology
      </h2>
    </div>

    <div class="world-ref-dock-actions">
      <a
        id="world-dock-open-full"
        class="world-ref-dock-btn"
        href="/lab/methodology"
        aria-label="Open current reference document in full page"
      >
        Open full page ↗
      </a>
      <button
        id="world-dock-close"
        class="world-ref-dock-btn world-ref-dock-btn--close"
        type="button"
        aria-label="Close Reference Workspace (Alt+Enter)"
      >
        Close [Esc]
      </button>
    </div>
  </header>

  <nav class="world-ref-dock-presets" aria-label="Pintasan dokumen referensi">
    <button
      type="button"
      class="world-ref-preset-btn"
      data-dock-target="/lab/methodology"
      data-dock-label="ISPU P.14/2020 Methodology"
    >
      ISPU Methodology
    </button>
    <button
      type="button"
      class="world-ref-preset-btn"
      data-dock-target="/codex"
      data-dock-label="The Grand Codex (100-600)"
    >
      Grand Codex
    </button>
    <button
      type="button"
      class="world-ref-preset-btn"
      data-dock-target="/archive/adr"
      data-dock-label="Engineering Records Vault"
    >
      ADR Vault
    </button>
    <button
      type="button"
      class="world-ref-preset-btn"
      data-dock-target="/atlas"
      data-dock-label="Progressive World Atlas"
    >
      World Atlas
    </button>
  </nav>

  <div class="world-ref-dock-status" id="world-dock-status" role="status" aria-live="polite">
    SANDBOXED STATIC VIEW (SCRIPTS DISABLED) · READY
  </div>

  <div class="world-ref-dock-frame-wrap">
    <iframe
      id="world-dock-iframe"
      class="world-ref-dock-iframe"
      sandbox=""
      loading="lazy"
      referrerpolicy="same-origin"
      title="Reference Workspace Static Document Viewer"
    ></iframe>
  </div>
</aside>
