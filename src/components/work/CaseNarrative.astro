---
/*
 * CaseNarrative.astro: panggung scrollytelling 3 scene
 * (Masalah -> Proses -> Temuan) untuk halaman case study.
 */
const { narrative } = Astro.props;
---

{narrative && narrative.length > 0 && (
  <section class="case-narrative" id="case-narrative" aria-label="Project narrative">
    <div class="narrative-stage">
      <div class="narrative-visuals">
        {narrative.map((scene, i) => (
          <div class="narrative-visual" data-scene={i}>
            {scene.image ? (
              <img src={scene.image} alt={scene.alt ?? scene.title} loading="lazy" decoding="async" />
            ) : (
              <div class="narrative-placeholder"></div>
            )}
          </div>
        ))}
      </div>
      <div class="narrative-texts">
        {narrative.map((scene, i) => (
          <div class="narrative-text" data-scene={i}>
            <p class="mini-label">{scene.label} / 0{i + 1}</p>
            <h2>{scene.title}</h2>
            <p>{scene.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
