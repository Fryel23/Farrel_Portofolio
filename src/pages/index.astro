---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Curtain from '../components/home/Curtain.astro';
import ProjectCard from '../components/work/ProjectCard.astro';
import ReservedCard from '../components/work/ReservedCard.astro';
import { getCollection } from 'astro:content';
import '../styles/home.css';
import '../styles/work.css';
import '../styles/about.css';
import '../styles/connect.css';
import '../styles/curtain.css';
import '../styles/hero-webgl.css';

const entries = (await getCollection('work')).sort((a, b) =>
  (a.data.status === 'RESERVED' ? 1 : 0) - (b.data.status === 'RESERVED' ? 1 : 0)
);
const projects = entries.filter((e) => e.data.status !== 'RESERVED');
const reserved = entries.filter((e) => e.data.status === 'RESERVED');
---

<BaseLayout
  pageKey="home"
  description="Portofolio Farrel Islami Putra, mahasiswa Informatika UNIKOM: proyek data yang sedang berjalan, ringkasan profil, dan kanal kontak. Semua ditulis apa adanya sebagai catatan proses belajar."
>
  <Curtain />

  <Hero />

  <div class="transition-ribbon" aria-hidden="true"><span></span></div>

  <!-- ============ SELECTED WORK ============ -->
  <section class="gallery-section" id="work" aria-labelledby="gallery-heading">
    <div class="desktop-frame desktop-frame--tl" aria-hidden="true"></div>
    <div class="desktop-frame desktop-frame--br" aria-hidden="true"></div>
    <div class="gallery-curve" aria-hidden="true"></div>
    <div class="section-inner gallery-inner">
      <div class="ornament ornament-gallery-truchet" aria-hidden="true">
        <svg width="100%" height="100%" focusable="false">
          <defs>
            <pattern id="ornament-gallery-truchet-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 0,20 A 20,20 0 0,1 20,0" fill="none" stroke="currentColor" stroke-width="1" />
              <path d="M 40,20 A 20,20 0 0,1 20,40" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#ornament-gallery-truchet-pattern)"></rect>
        </svg>
      </div>
      <div class="ornament ornament-gallery-stamp" aria-hidden="true">ARCHIVE / 01</div>
      <div class="section-heading section-heading-light">
        <div>
          <p class="section-kicker">02 / STUDI KASUS UNGGULAN</p>
          <h2 class="display-heading" id="gallery-heading">
            <span class="line-mask"><span class="line">Karya &amp;</span></span>
            <span class="line-mask"><span class="line"><em>riset terpilih.</em></span></span>
          </h2>
        </div>
        <p class="heading-aside" id="gallery-aside">Satu riset kualitas udara Cirebon (2021–2025) yang sedang berjalan disertai penjelajah data interaktif, serta ruang arsip untuk eksperimen berikutnya. Semua ditulis apa adanya.</p>
      </div>

      <div class="gallery-ruler" aria-hidden="true">
        <span>01</span><span>02</span><span>03</span>
      </div>

      <div class="project-grid" id="project-grid" aria-live="polite">
        {projects.map((entry, index) => (
          <ProjectCard
            project={{
              ...entry.data,
              id: entry.id,
              href: `/work/${entry.id}`,
            }}
            index={index}
          />
        ))}
        {reserved.map((entry, index) => (
          <ReservedCard
            slot={{
              title: entry.data.title,
              kicker: entry.data.kicker,
              description: entry.data.description,
              category: entry.data.category,
            }}
            index={index}
          />
        ))}
      </div>

      <div class="gallery-bottom-line"><span>TERUS MENJELAJAH</span><a href="/work">LIHAT HALAMAN PROYEK LENGKAP →</a></div>
    </div>
  </section>

  <div class="transition-ribbon" aria-hidden="true"><span></span></div>

  <!-- ============ 03 / EXPLORATION BRIDGE (OVERLAPPING SPLIT-TONE) ============ -->
  <section class="explore-bridge-section section-shell" id="explore-bridge" aria-labelledby="explore-bridge-heading">
    <div class="section-heading">
      <div>
        <p class="section-kicker">03 / JEMBATAN EKSPLORASI · EXPLORATION BRIDGE</p>
        <h2 class="display-heading" id="explore-bridge-heading">
          <span class="line-mask"><span class="line">Eksplorasi langsung</span></span>
          <span class="line-mask"><span class="line"><em>data &amp; arsip sistem.</em></span></span>
        </h2>
      </div>
      <p class="heading-aside">Selain membaca narasi studi kasus, Anda bisa langsung menguji dataset di sandbox interaktif atau menelusuri keputusan arsitektur di balik situs ini.</p>
    </div>

    <div class="explore-bridge-grid">
      <article class="explore-bridge-card explore-bridge-card--light" aria-labelledby="bridge-sandbox-title">
        <div class="explore-bridge-meta">
          <span class="explore-bridge-kicker">03A / INTERACTIVE SANDBOX · LABORATORIUM DATA</span>
          <span class="explore-bridge-badge">CLIENT-SIDE LAB</span>
        </div>
        <h3 class="explore-bridge-title" id="bridge-sandbox-title">Uji Sendiri Data di The Data Lab</h3>
        <p class="explore-bridge-desc">
          Eksplorasi seri waktu ISPU, SO₂, dan NO₂ dari 23 titik pantau Cirebon (2021–2025) lengkap dengan pita ambang PermenLHK P.14/2020 dan peta spasial stasiun, atau profilkan file CSV Anda sendiri langsung di peramban.
        </p>
        <ul class="explore-bridge-points">
          <li><strong>AQI Cirebon Explorer:</strong> Filter tahun (2021–2025), pilih parameter (ISPU/SO₂/NO₂), dan inspeksi koridor pantau.</li>
          <li><strong>Client-Side CSV Profiler:</strong> Deteksi tipe kolom, missing rate, outlier IQR, dan matriks korelasi Pearson secara instan.</li>
        </ul>
        <div class="explore-bridge-actions">
          <a class="button button-primary" href="/lab">Buka AQI Data Lab (/lab) <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/lab/csv">Coba CSV Profiler (/lab/csv) <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="explore-bridge-card explore-bridge-card--dark" id="home-portal-branch-card" aria-labelledby="bridge-archive-title">
        <div class="explore-bridge-meta">
          <span class="explore-bridge-kicker">03B / THE BRANCH PORTAL · GERBANG DUNIA INTERAKTIF</span>
          <span class="explore-bridge-badge">AETHELGRAD + KNOWLEDGE CRYPT</span>
        </div>
        <h3 class="explore-bridge-title" id="bridge-archive-title">Masuk Dunia: Aethelgrad</h3>
        <p class="explore-bridge-desc">
          Eksplorasi dunia RPG interaktif dengan koleksi pahlawan piksel, tantangan logika, dan arena peringkat.
        </p>
        <ul class="explore-bridge-points">
          <li><strong>Aethelgrad (/aethelgrad):</strong> Eksplorasi dunia RPG interaktif dengan koleksi pahlawan piksel, tantangan logika, dan arena peringkat.</li>
          <li><strong>The Data Atlas Crypt (/atlas):</strong> Peta konstelasi 36 simpul pengetahuan, 52 sinapsis, dan Live Performance Telemetry HUD.</li>
        </ul>
        <div class="explore-bridge-actions">
          <button
            type="button"
            class="explore-bridge-dark-btn explore-bridge-dark-btn--primary portal-dive-trigger"
            data-portal-dive="/aethelgrad"
          >
            Masuk Dunia: Aethelgrad <span aria-hidden="true">↗</span>
          </button>
          <a class="explore-bridge-dark-btn explore-bridge-dark-btn--ghost" href="/atlas">Buka The Data Atlas Crypt (/atlas) <span aria-hidden="true">→</span></a>
          <a class="explore-bridge-dark-btn explore-bridge-dark-btn--ghost" href="/aethelgrad">Buka Langsung (/aethelgrad) <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

  <div class="transition-ribbon" aria-hidden="true"><span></span></div>

  <!-- ============ 04 / PROFIL & KONTAK SINGKAT (ringkasan) ============ -->
  <div id="home-teasers">
    <section class="about-section section-shell" id="about" aria-labelledby="about-heading">
      <div class="geo geo-four" aria-hidden="true"></div>
      <div class="geo geo-five" aria-hidden="true"></div>
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 / PROFIL &amp; KONTAK SINGKAT · THE PERSON BEHIND THE CODE</p>
          <h2 class="display-heading" id="about-heading">
            <span class="line-mask"><span class="line">Rasa ingin tahu</span></span>
            <span class="line-mask"><span class="line"><em>sebagai awal.</em></span></span>
          </h2>
        </div>
        <div class="heading-stamp">TELITI PADA<br /><b>DETAIL</b><span aria-hidden="true">✳</span></div>
      </div>
      <div class="about-summary">
        <p class="about-summary-lead" id="about-lead">Saya memilih Teknik Informatika di UNIKOM karena ingin memahami bagaimana data, perangkat lunak, dan sistem cerdas bekerja dari balik layar untuk membantu menyelesaikan masalah nyata sehari-hari.</p>
        <div class="about-summary-actions">
          <a class="button button-primary" href="/about">Baca Profil Lengkap <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/about#journey">Perjalanan Belajar <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <div class="transition-ribbon" aria-hidden="true"><span></span></div>

    <!-- ============ CONTACT (ringkasan) ============ -->
    <section class="social-section" id="profiles" aria-labelledby="social-heading">
      <div class="social-pattern" aria-hidden="true"></div>
      <div class="section-inner social-inner">
        <p class="section-kicker">04B / KANAL KOMUNIKASI &amp; ARSIP · FIND ME ELSEWHERE</p>
        <div class="social-heading-row">
          <h2 class="display-heading" id="social-heading">
            <span class="line-mask"><span class="line">Mari tetap</span></span>
            <span class="line-mask"><span class="line"><em>terhubung.</em></span></span>
          </h2>
          <p class="social-intro" id="social-intro">Semua profil dan repositori proyek terverifikasi milik saya di GitHub (@Fryel23 &amp; @Fryel32) serta folder dokumentasi riset di Google Drive.</p>
        </div>
        <div class="about-summary-actions">
          <a class="button button-primary" href="/connect">Hubungi Saya <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/archive">Jelajahi Arsip Lengkap <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/global.js';
  import '../scripts/work.js';
  import '../scripts/home.js';
</script>
