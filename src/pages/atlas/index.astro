---
/**
 * src/pages/atlas/index.astro
 * THE DATA ATLAS CRYPT (/atlas).
 *
 * Ruang Pengetahuan & Telemetri Performa Real-Time:
 *  - 36 Simpul Pengetahuan (Knowledge Nodes) & 52 Sinapsis (Edges)
 *    lintas 4 Klaster Keilmuan Farrel Islami Putra.
 *  - Kanvas Konstelasi Interaktif (#atlas-network-canvas) + Inspector Panel (#atlas-inspector-panel).
 *  - Live Performance Telemetry HUD (FPS, Frame Time ms, JS Heap, Active Nodes/Synapses).
 *  - Jembatan Portal menuju Dunia Aethelgrad (/aethelgrad).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ATLAS_CLUSTERS,
  ATLAS_EDGES,
  ATLAS_NODES,
} from '../../scripts/atlas/knowledge-nodes-data.ts';
import '../../styles/atlas.css';

const initialNode = ATLAS_NODES[0];
---

<BaseLayout
  title="The Data Atlas Crypt · Knowledge Graph & Live Telemetry · Farrel Islami Putra"
  description="The Data Atlas Crypt: Peta konstelasi 36 simpul pengetahuan interaktif, 52 sinapsis lintas 4 klaster keilmuan, dan Live Performance Telemetry HUD milik Farrel Islami Putra."
  pageKey="atlas"
>
  <div class="atlas-crypt-page" id="atlas-page-root">
    <!-- ==================== 01 / HERO & LIVE PERFORMANCE TELEMETRY HUD ==================== -->
    <header class="atlas-crypt-hero" aria-labelledby="atlas-page-heading">
      <div class="atlas-hero-copy">
        <p class="atlas-kicker">CRYPT-01 · THE DATA ATLAS CRYPT · KNOWLEDGE CONSTELLATION</p>
        <h1 class="atlas-title" id="atlas-page-heading">
          Peta Konstelasi <em>Pengetahuan</em> &amp; Telemetri Sistem.
        </h1>
        <p class="atlas-lead">
          Selamat datang di <strong>The Data Atlas Crypt</strong>. Berbeda dengan dunia permainan virtual <em>Aethelgrad</em>, ruang ini adalah peta pengetahuan interaktif tempat <strong>{ATLAS_NODES.length} simpul keilmuan</strong> dan <strong>{ATLAS_EDGES.length} sinapsis teknis</strong> milik Farrel Islami Putra saling terhubung lintas Data Science, Software/AI, Sistem Kuantitatif, dan Logika Strategis.
        </p>
      </div>

      <!-- Live Performance & System Telemetry HUD -->
      <aside class="atlas-telemetry-hud" id="atlas-telemetry-hud" aria-label="Live Performance Telemetry HUD">
        <div class="atlas-telemetry-header">
          <span class="atlas-telemetry-dot" aria-hidden="true"></span>
          <span class="atlas-telemetry-title">LIVE PERFORMANCE TELEMETRY HUD</span>
          <span class="atlas-telemetry-badge" id="atlas-telemetry-status">OPTIMAL · 60Hz LOCK</span>
        </div>
        <div class="atlas-telemetry-grid">
          <div class="atlas-telemetry-cell">
            <span class="atlas-telemetry-label">FRAME RATE</span>
            <strong class="atlas-telemetry-value" id="atlas-telemetry-fps">60 FPS</strong>
          </div>
          <div class="atlas-telemetry-cell">
            <span class="atlas-telemetry-label">FRAME BUDGET</span>
            <strong class="atlas-telemetry-value" id="atlas-telemetry-frametime">16.7 ms</strong>
          </div>
          <div class="atlas-telemetry-cell">
            <span class="atlas-telemetry-label">JS HEAP MEMORY</span>
            <strong class="atlas-telemetry-value" id="atlas-telemetry-heap">MEASURING...</strong>
          </div>
          <div class="atlas-telemetry-cell">
            <span class="atlas-telemetry-label">ACTIVE DOM / GRAPH</span>
            <strong class="atlas-telemetry-value" id="atlas-telemetry-graph">
              {ATLAS_NODES.length} Nodes / {ATLAS_EDGES.length} Synapses
            </strong>
          </div>
        </div>
      </aside>
    </header>

    <!-- ==================== 02 / FILTER BAR & CLUSTER LEGEND ==================== -->
    <section class="atlas-toolbar-section" aria-label="Filter klaster dan pencarian simpul pengetahuan">
      <div class="atlas-cluster-pills" role="group" aria-label="Filter berdasarkan klaster keilmuan">
        <button
          type="button"
          class="atlas-cluster-pill is-active"
          data-atlas-cluster="ALL"
          aria-pressed="true"
        >
          Semua Klaster ({ATLAS_NODES.length})
        </button>
        {ATLAS_CLUSTERS.map((cluster) => {
          const count = ATLAS_NODES.filter((n) => n.cluster === cluster.id).length;
          return (
            <button
              type="button"
              class="atlas-cluster-pill"
              data-atlas-cluster={cluster.id}
              aria-pressed="false"
              style={`--cluster-accent: ${cluster.color};`}
            >
              <span class="atlas-cluster-dot" style={`background:${cluster.color};`} aria-hidden="true"></span>
              {cluster.code} · {cluster.label} ({count})
            </button>
          );
        })}
      </div>

      <div class="atlas-search-controls">
        <label class="sr-only" for="atlas-search-input">Cari simpul pengetahuan</label>
        <input
          id="atlas-search-input"
          class="atlas-search-input"
          type="search"
          placeholder="Filter simpul (misal: ISPU, CSV, PBKDF2, SQL, Graph)..."
          autocomplete="off"
        />
        <button type="button" id="atlas-reset-btn" class="atlas-reset-btn">
          Reset Konstelasi
        </button>
      </div>
    </section>

    <!-- ==================== 03 / INTERACTIVE FORCE-CONSTELLATION WORKBENCH ==================== -->
    <section class="atlas-workbench" aria-label="Kanvas konstelasi pengetahuan dan panel inspeksi simpul">
      <div class="atlas-canvas-stage">
        <div class="atlas-canvas-topline">
          <span>INTERACTIVE 2D SYNAPSE FIELD · DRAG OR CLICK ANY NODE</span>
          <span>36 NODES · 52 SYNAPSES · 4 CLUSTERS</span>
        </div>
        <canvas
          id="atlas-network-canvas"
          class="atlas-network-canvas"
          width="1000"
          height="620"
          aria-label="Graf konstelasi interaktif 36 simpul pengetahuan Farrel Islami Putra"
        ></canvas>
        <div class="atlas-canvas-caption">
          <span>TIP: Klik simpul untuk melihat rumus/catatan teknis dan daftar sinapsis yang terhubung.</span>
          <span>REDUCED-MOTION SAFE</span>
        </div>
      </div>

      <!-- Node Inspector Panel -->
      <aside class="atlas-inspector-panel" id="atlas-inspector-panel" aria-live="polite">
        <div class="atlas-insp-header">
          <span class="atlas-insp-code" id="atlas-insp-code">{initialNode.code}</span>
          <span class="atlas-insp-cluster" id="atlas-insp-cluster">{initialNode.cluster}</span>
        </div>
        <h2 class="atlas-insp-title" id="atlas-insp-title">{initialNode.title}</h2>
        <p class="atlas-insp-status-row">
          <span>STATUS EKSPLORASI:</span>
          <strong id="atlas-insp-status">{initialNode.status}</strong>
        </p>
        <p class="atlas-insp-summary" id="atlas-insp-summary">{initialNode.summary}</p>

        <div class="atlas-insp-tech-box">
          <span class="atlas-insp-box-label">FORMULA / CATATAN TEKNIS</span>
          <code id="atlas-insp-tech">{initialNode.technicalNote}</code>
        </div>

        <a
          id="atlas-insp-route"
          class="atlas-insp-route-btn"
          href={initialNode.relatedRoute || '/lab'}
        >
          {initialNode.relatedLabel || 'Buka Halaman Terkait'} →
        </a>

        <div class="atlas-insp-synapses-wrap">
          <p class="atlas-insp-box-label">SINAPSIS TERHUBUNG (KLIK UNTUK LOMPAT)</p>
          <ul class="atlas-insp-synapses" id="atlas-insp-synapses"></ul>
        </div>
      </aside>
    </section>

    <!-- ==================== 04 / ACCESSIBLE 4-CLUSTER DIRECTORY ==================== -->
    <section class="atlas-directory-section" aria-labelledby="atlas-directory-heading">
      <div class="atlas-section-head">
        <p class="atlas-kicker">02 · COMPLETE KNOWLEDGE LEDGER · ACCESSIBLE NODE INDEX</p>
        <h2 class="atlas-section-title" id="atlas-directory-heading">
          Direktori Lengkap 36 Simpul Pengetahuan
        </h2>
        <p class="atlas-section-desc">
          Seluruh simpul konstelasi dapat dijelajahi menggunakan papan ketik atau pembaca layar melalui indeks terstruktur di bawah ini.
        </p>
      </div>

      <div class="atlas-cluster-overview-grid">
        {ATLAS_CLUSTERS.map((cluster) => (
          <article class="atlas-cluster-summary-card" style={`--cluster-accent: ${cluster.color};`}>
            <div class="atlas-cluster-card-top">
              <span class="atlas-cluster-code">{cluster.code}</span>
              <span class="atlas-cluster-dot" style={`background:${cluster.color};`} aria-hidden="true"></span>
            </div>
            <h3>{cluster.label}</h3>
            <p>{cluster.description}</p>
          </article>
        ))}
      </div>

      <div class="atlas-node-directory-grid" id="atlas-node-list">
        {ATLAS_NODES.map((node, idx) => (
          <button
            type="button"
            class:list={['atlas-node-card', { 'is-selected': idx === 0 }]}
            data-atlas-node-id={node.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            <div class="atlas-node-card-top">
              <span class="atlas-node-card-code">{node.code}</span>
              <span class="atlas-node-card-status">{node.status}</span>
            </div>
            <strong class="atlas-node-card-title">{node.title}</strong>
            <span class="atlas-node-card-note">{node.technicalNote}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="atlas-portal-banner" aria-labelledby="atlas-portal-heading">
      <div class="atlas-portal-copy">
        <p class="atlas-kicker">GERBANG EKSPEDISI · AETHELGRAD</p>
        <h2 class="atlas-portal-title" id="atlas-portal-heading">
          Masuk Dunia: <em>Aethelgrad</em>
        </h2>
        <p class="atlas-portal-desc">
          Eksplorasi dunia RPG interaktif dengan koleksi pahlawan piksel, tantangan logika, dan arena peringkat.
        </p>
      </div>
      <div class="atlas-portal-actions">
        <button
          type="button"
          class="atlas-portal-dive-btn portal-dive-trigger"
          data-portal-dive="/aethelgrad"
        >
          Masuk Dunia: Aethelgrad
        </button>
        <a href="/lab" class="atlas-portal-secondary-btn">
          Kembali ke Data Lab (/lab) →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  import { initDataAtlasCrypt } from '../../scripts/atlas/data-atlas-crypt.ts';

  initDataAtlasCrypt();
  document.addEventListener('astro:page-load', () => {
    initDataAtlasCrypt();
  });
</script>
