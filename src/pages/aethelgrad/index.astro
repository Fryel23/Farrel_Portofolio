---
import '../../styles/aethelgrad/aethelgrad-core.css';
import '../../styles/aethelgrad/neural-dive-auth.css';
import '../../styles/aethelgrad/paperdoll-stage.css';
import '../../styles/aethelgrad/gacha-summon.css';
import '../../styles/aethelgrad/colosseum-battle.css';
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aethelgrad · Dunia RPG Pahlawan Piksel, Grimoire &amp; Arena</title>
    <meta
      name="description"
      content="Jelajahi Aethelgrad: dunia RPG interaktif dengan 24 pahlawan piksel 16-bit, 50 perlengkapan tempur, buku koleksi Grimoire, tantangan logika Trials, dan Arena Colosseum."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="aethelgrad-body">
    <section
      id="aethelgrad-title-screen"
      class="aethelgrad-title-screen"
      aria-label="Layar Pembuka Aethelgrad"
    >
      <div class="title-screen-card">
        <div class="title-emblem-ring" aria-hidden="true">✦</div>
        <span class="title-eyebrow">CHRONICLES OF THE STARLIGHT CITADEL</span>
        <h1 class="title-main-heading">Aethelgrad</h1>
        <p class="title-lore-desc">
          Di balik kabut abadi menara kuno, para Hunter berkumpul menguji strategi, merangkai pusaka
          bintang, dan mengasah ketajaman logika sebelum melangkah ke gelanggang Colosseum.
        </p>
        <div class="title-feature-pills">
          <span>24 Pahlawan Orisinal</span>
          <span>50 Pusaka Tempur 16-Bit</span>
          <span>24 Ujian Logika Rune</span>
          <span>Gelanggang Colosseum</span>
        </div>
        <button type="button" id="title-enter-spire-btn" class="title-enter-cta">
          Masuki Gerbang Aethelgrad
        </button>
      </div>
    </section>

    <section
      id="aethelgrad-auth-gate"
      class="aethelgrad-auth-gate is-dismissed"
      aria-label="Gerbang Identitas Hunter"
    >
      <div class="auth-gate-card">
        <div class="auth-guild-header">
          <span>✦ GUILD REGISTRY · AETHELGRAD</span>
          <span>HUNTER PASSPORT</span>
        </div>
        <div id="auth-returning-hunter-badge" class="auth-returning-badge hidden"></div>
        <h2 id="auth-gate-title">Daftarkan Identitas Hunter</h2>
        <p id="auth-gate-subtitle">
          Buat identitas Hunter baru untuk menerima bekal awal 1.800 Astral Gems, 5 Summon Tickets,
          dan akses penuh ke seluruh wilayah Aethelgrad.
        </p>

        <form id="aethelgrad-auth-form" class="auth-form" autocomplete="off">
          <div class="auth-field">
            <label for="auth-username-input">Nama Panggilan Hunter</label>
            <input
              type="text"
              id="auth-username-input"
              name="username"
              required
              minlength="3"
              maxlength="20"
              placeholder="Contoh: Vanguard_702"
            />
          </div>

          <div class="auth-field">
            <label for="auth-password-input">Kata Sandi Rahasia (Min. 8 Karakter)</label>
            <input
              type="password"
              id="auth-password-input"
              name="password"
              required
              minlength="8"
              maxlength="64"
              placeholder="••••••••••••"
            />
          </div>

          <div id="auth-confirm-password-wrap" class="auth-field">
            <label for="auth-confirm-input">Konfirmasi Kata Sandi</label>
            <input
              type="password"
              id="auth-confirm-input"
              name="confirmPassword"
              maxlength="64"
              placeholder="Ketik ulang kata sandi"
            />
          </div>

          <div id="auth-feedback-box" class="auth-feedback-box" role="status"></div>

          <button type="submit" id="auth-submit-btn" class="auth-submit-cta">
            Mulai Perjalanan di Aethelgrad
          </button>
        </form>

        <button type="button" id="auth-switch-mode-btn" class="auth-switch-mode-btn">
          Sudah memiliki identitas Hunter? Masuk di sini
        </button>
      </div>
    </section>

    <div id="aethelgrad-hud-shell" class="aethelgrad-hud-shell">
      <header id="aethelgrad-topbar" class="ag-topbar">
        <button
          type="button"
          id="ag-brand-home"
          class="ag-brand-btn"
          data-scene-jump="outpost"
          aria-label="Kembali ke Outpost Aethelgrad"
        >
          <span class="ag-brand-emblem" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
              <path
                d="M12 2L19 9L12 22L5 9L12 2Z"
                stroke="#D4AF6A"
                stroke-width="1.6"
                fill="rgba(212, 175, 106, 0.16)"
              />
              <path d="M12 6L15.5 9.5L12 17L8.5 9.5L12 6Z" fill="#F8FAFC" />
            </svg>
          </span>
          <span class="ag-brand-name">Aethelgrad</span>
        </button>

        <nav id="ag-scene-nav" class="ag-scene-nav" aria-label="Navigasi Wilayah Aethelgrad">
          <button
            type="button"
            class="ag-scene-tab is-active"
            data-scene-tab="outpost"
            data-scene-target="outpost"
            aria-current="page"
          >
            Outpost
          </button>
          <button type="button" class="ag-scene-tab" data-scene-tab="summon" data-scene-target="summon">
            Summon
          </button>
          <button type="button" class="ag-scene-tab" data-scene-tab="barracks" data-scene-target="barracks">
            Barracks
          </button>
          <button type="button" class="ag-scene-tab" data-scene-tab="grimoire" data-scene-target="grimoire">
            Grimoire
          </button>
          <button type="button" class="ag-scene-tab" data-scene-tab="trials" data-scene-target="trials">
            Trials
          </button>
          <button type="button" class="ag-scene-tab" data-scene-tab="arena" data-scene-target="arena">
            Arena
          </button>
        </nav>

        <div class="ag-topbar-right">
          <div class="ag-resource-Cluster" aria-label="Sumber Daya Hunter">
            <div class="ag-resource-pill" title="Astral Gems">
              <span class="ag-res-icon" aria-hidden="true">✦</span>
              <span class="ag-res-label">Gems</span>
              <strong id="hud-astral-gems">1,800</strong>
            </div>
            <div class="ag-resource-pill" title="Summon Tickets">
              <span class="ag-res-icon" aria-hidden="true">🎟</span>
              <span class="ag-res-label">Tickets</span>
              <strong id="hud-summon-tickets">5</strong>
            </div>
            <div class="ag-resource-pill ag-resource-pill--dust" title="Starlight Dust">
              <span class="ag-res-icon" aria-hidden="true">✧</span>
              <strong id="hud-starlight-dust">200</strong>
            </div>
          </div>

          <div class="ag-hunter-pill">
            <div class="ag-hunter-meta">
              <strong id="hud-hunter-username">Vanguard_702</strong>
              <span id="hud-hunter-title">Data Ranger · CP <b id="hud-combat-power">3,850</b></span>
            </div>
          </div>

          <button
            type="button"
            id="hud-sound-toggle-btn"
            class="ag-icon-btn"
            aria-label="Pengaturan Suara"
            title="Suara"
          >
            🔊
          </button>
          <button
            type="button"
            id="hud-logout-btn"
            class="ag-icon-btn"
            aria-label="Keluar dari Sesi Hunter"
            title="Keluar Sesi"
          >
            ⏻
          </button>
          <a href="/" class="ag-return-btn">
            <svg
              viewBox="0 0 20 20"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="7.5" />
              <polygon points="8,12 9.5,7.5 13,8 11.5,12.5" fill="currentColor" stroke="none" />
            </svg>
            <span>Kembali ke Portofolio</span>
          </a>
        </div>
      </header>

      <main id="aethelgrad-stage" class="ag-stage" data-active-scene="outpost">
        <!-- SCENE 1: OUTPOST -->
        <section class="ag-scene is-active" id="scene-outpost" data-scene-panel="outpost">
          <div class="ag-outpost-layout">
            <div class="ag-outpost-companion-zone">
              <div class="ag-outpost-ambient-particles" aria-hidden="true">
                <span class="ag-mote ag-mote--1"></span>
                <span class="ag-mote ag-mote--2"></span>
                <span class="ag-mote ag-mote--3"></span>
                <span class="ag-mote ag-mote--4"></span>
              </div>

              <div class="ag-outpost-hero-header">
                <span class="ag-kicker" id="outpost-companion-role">STARLIGHT VANGUARD</span>
                <h1 class="ag-serif-title" id="outpost-companion-name">Evelyn, Dawn Blade</h1>
                <p class="ag-companion-sub" id="outpost-companion-title">
                  Valkyrie of the First Horizon · ★5
                </p>
              </div>

              <div
                id="outpost-hero-hitbox"
                class="ag-outpost-pedestal-stage"
                role="button"
                tabindex="0"
                aria-label="Klik karakter pendamping untuk berbiara"
              >
                <div id="outpost-hero-stage" class="ag-outpost-sprite-mount"></div>
                <div class="ag-pedestal-glow-ring" aria-hidden="true"></div>
              </div>

              <div class="ag-outpost-dialogue-card">
                <div class="ag-dialogue-speaker">
                  <span id="outpost-dialogue-speaker">Evelyn</span>
                  <small>Klik karakter untuk berbincang</small>
                </div>
                <p id="outpost-dialogue-text" class="ag-dialogue-quote">
                  "Angin di puncak menara mulai berubah. Senjata mana yang akan kita uji hari ini?"
                </p>
                <div class="ag-dialogue-actions">
                  <button
                    type="button"
                    id="outpost-cycle-companion-btn"
                    class="ag-secondary-btn"
                  >
                    Ganti Karakter Pendamping
                  </button>
                  <button
                    type="button"
                    class="ag-ghost-btn"
                    data-scene-jump="barracks"
                  >
                    Atur Perlengkapan →
                  </button>
                </div>
              </div>
            </div>

            <div class="ag-outpost-command-zone">
              <article class="ag-hunter-dossier-card">
                <div class="ag-dossier-top">
                  <div>
                    <span class="ag-kicker">HUNTER DOSSIER</span>
                    <h2 class="ag-dossier-name" id="outpost-hunter-name">Vanguard_702</h2>
                    <p class="ag-dossier-rank" id="outpost-hunter-rank">
                      Data Ranger · Menara Aethelgrad
                    </p>
                  </div>
                  <div class="ag-dossier-cp-box">
                    <span>COMBAT POWER</span>
                    <strong id="outpost-hunter-cp">3,850</strong>
                  </div>
                </div>
                <div class="ag-dossier-metrics" id="outpost-collection-summary">
                  <div>
                    <span>Pahlawan</span>
                    <strong id="outpost-stat-heroes">3 / 24</strong>
                  </div>
                  <div>
                    <span>Pusaka</span>
                    <strong id="outpost-stat-items">7 / 50</strong>
                  </div>
                  <div>
                    <span>Trials</span>
                    <strong id="outpost-stat-trials">0 / 24</strong>
                  </div>
                  <div>
                    <span>Kemenangan</span>
                    <strong id="outpost-stat-wins">0 Duel</strong>
                  </div>
                </div>
              </article>

              <div class="ag-outpost-gates-grid" aria-label="Gerbang Wilayah Aethelgrad">
                <button
                  type="button"
                  class="ag-gate-card ag-gate-card--featured"
                  data-scene-jump="summon"
                >
                  <span class="ag-gate-tag">ALTAR BINTANG</span>
                  <strong class="ag-gate-title">Summon Altar</strong>
                  <p class="ag-gate-desc">
                    Panggil pahlawan legendaris dan persenjataan pusaka dari rasi bintang kuno.
                  </p>
                  <span class="ag-gate-cta">Masuki Altar →</span>
                </button>

                <button type="button" class="ag-gate-card" data-scene-jump="barracks">
                  <span class="ag-gate-tag">KUSTOMISASI 16-BIT</span>
                  <strong class="ag-gate-title">Hero Barracks</strong>
                  <p class="ag-gate-desc">
                    Pasang 5 slot perlengkapan yang langsung mengubah wujud karakter.
                  </p>
                  <span class="ag-gate-cta">Buka Barak →</span>
                </button>

                <button type="button" class="ag-gate-card" data-scene-jump="arena">
                  <span class="ag-gate-tag">GELANGGANG DUEL</span>
                  <strong class="ag-gate-title">Arena Colosseum</strong>
                  <p class="ag-gate-desc">
                    Tantang penjaga menara dalam pertarungan giliran dan raih peringkat puncak.
                  </p>
                  <span class="ag-gate-cta">Masuki Arena →</span>
                </button>

                <button type="button" class="ag-gate-card" data-scene-jump="grimoire">
                  <span class="ag-gate-tag">ENSIKLOPEDIA &amp; TEMPA</span>
                  <strong class="ag-gate-title">Grimoire Archive</strong>
                  <p class="ag-gate-desc">
                    Lengkapi ikatan koleksi pusaka, naikkan bintang pahlawan, dan sintesis senjata.
                  </p>
                  <span class="ag-gate-cta">Buka Grimoire →</span>
                </button>

                <button
                  type="button"
                  class="ag-gate-card ag-gate-card--wide"
                  data-scene-jump="trials"
                >
                  <span class="ag-gate-tag">UJIAN ALGORITMA RUNE</span>
                  <strong class="ag-gate-title">Logic Trials</strong>
                  <p class="ag-gate-desc">
                    Pecahkan 24 teka-teki logika kuno untuk memperoleh Gems serta berkat stat
                    permanen bagi seluruh pahlawan.
                  </p>
                  <span class="ag-gate-cta">Mulai Ujian →</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- SCENE 2: SUMMON -->
        <section class="ag-scene" id="scene-summon" data-scene-panel="summon" hidden>
          <div class="ag-summon-layout">
            <aside class="ag-summon-sidebar">
              <span class="ag-kicker">PILIH ALTAR PEMANGGILAN</span>
              <div class="ag-banner-tabs" role="tablist" aria-label="Daftar Banner Summon">
                <button
                  type="button"
                  class="ag-banner-tab is-active"
                  data-banner-id="HERO_SOVEREIGN_BANNER"
                  role="tab"
                  aria-selected="true"
                >
                  <span class="ag-banner-tab-tag">FEATURED HEROES</span>
                  <strong>Sovereign Hero Invocation</strong>
                  <small>Peluang tinggi Pahlawan ★5 &amp; Pendamping Utama</small>
                </button>

                <button
                  type="button"
                  class="ag-banner-tab"
                  data-banner-id="ARMS_RELIC_BANNER"
                  role="tab"
                  aria-selected="false"
                >
                  <span class="ag-banner-tab-tag">DIVINE ARSENAL</span>
                  <strong>Divine Arsenal Invocation</strong>
                  <small>Senjata Pusaka, Mahkota, Perisai &amp; Sayap ★5</small>
                </button>
              </div>

              <div class="ag-pity-box">
                <div class="ag-pity-head">
                  <span>Jaminan Bintang 5</span>
                  <strong id="summon-pity-text">0 / 50</strong>
                </div>
                <div class="ag-pity-track" aria-hidden="true">
                  <div id="summon-pity-bar" class="ag-pity-fill" style="width: 0%"></div>
                </div>
                <p class="ag-pity-note">
                  Peluang ★5 meningkat tajam sejak tarikan ke-35 dan dijamin 100% pada tarikan
                  ke-50.
                </p>
              </div>

              <button type="button" id="summon-open-rates-btn" class="ag-secondary-btn ag-full-btn">
                Lihat Daftar &amp; Peluang Item
              </button>
            </aside>

            <div class="ag-summon-poster-stage">
              <div class="ag-summon-poster-card">
                <div class="ag-summon-poster-copy">
                  <span class="ag-poster-badge" id="summon-banner-tag">
                    SOVEREIGN HERO INVOCATION
                  </span>
                  <h2 class="ag-serif-title" id="summon-banner-title">
                    Evelyn, Dawn Blade &amp; Zephyr, Astral Archon
                  </h2>
                  <p class="ag-poster-lore" id="summon-banner-lore">
                    Cahaya fajar dan badai kuantum berpadu di puncak altar. Panggil para ksatria
                    terkuat Aethelgrad untuk memperkuat barisan tempurmu.
                  </p>

                  <div class="ag-poster-skill-box">
                    <span class="ag-kicker">ULTIMATE SHOWCASE</span>
                    <strong id="summon-featured-skill">
                      Starfall Horizon Cleave · 320% Solar DMG
                    </strong>
                    <p id="summon-featured-quote">
                      "Selama pedang ini menyala, malam tidak akan menelan puncak menara."
                    </p>
                  </div>
                </div>

                <div class="ag-summon-poster-visual">
                  <div id="summon-featured-stage" class="ag-summon-sprite-showcase"></div>
                </div>
              </div>

              <div class="ag-summon-action-bar">
                <div class="ag-summon-Recent" id="summon-recent-summary">
                  Siap memanggil pusaka bintang. Tarikan 10x menjamin minimal ★4 atau ★5.
                </div>
                <div class="ag-summon-cta-group">
                  <button type="button" id="btn-gacha-pull-1" class="ag-summon-btn ag-summon-btn--1">
                    <span class="ag-summon-btn-title">Panggil 1x</span>
                    <small>100 Gems / 1 Ticket</small>
                  </button>
                  <button
                    type="button"
                    id="btn-gacha-pull-10"
                    class="ag-summon-btn ag-summon-btn--10"
                  >
                    <span class="ag-summon-btn-title">Panggil 10x</span>
                    <small>900 Gems (Hemat 10%)</small>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SCENE 3: BARRACKS -->
        <section class="ag-scene" id="scene-barracks" data-scene-panel="barracks" hidden>
          <div class="ag-barracks-layout">
            <!-- Left 280px: Filter Kelas & Grid Potret Pahlawan -->
            <aside class="ag-barracks-roster-col">
              <div class="ag-col-header">
                <span class="ag-kicker">DAFTAR PAHLAWAN</span>
                <h2 class="ag-col-title">Roster Barak</h2>
              </div>
              <div
                id="barracks-role-filters"
                class="ag-filter-pills"
                role="group"
                aria-label="Filter Kelas Pahlawan"
              >
                <button type="button" class="ag-filter-pill is-active" data-role-filter="ALL">
                  Semua
                </button>
                <button type="button" class="ag-filter-pill" data-role-filter="VANGUARD_BLADE">
                  Vanguard
                </button>
                <button type="button" class="ag-filter-pill" data-role-filter="ASTRAL_ARCHMAGE">
                  Archmage
                </button>
                <button type="button" class="ag-filter-pill" data-role-filter="AEGIS_PALADIN">
                  Paladin
                </button>
                <button type="button" class="ag-filter-pill" data-role-filter="SHADOW_ASSASSIN">
                  Shadow
                </button>
              </div>
              <div id="barracks-hero-grid" class="ag-barracks-hero-grid"></div>
            </aside>

            <!-- Center: Panggung 300x300, Identitas Hero, & 5 Slot Equipment -->
            <div class="ag-barracks-stage-col">
              <div class="ag-barracks-hero-banner">
                <div>
                  <span class="ag-kicker" id="barracks-hero-element">SOLAR LIGHT · VANGUARD</span>
                  <h2 class="ag-serif-title" id="barracks-hero-name">Evelyn, Dawn Blade</h2>
                  <p class="ag-barracks-subtitle" id="barracks-hero-title">
                    Valkyrie of the First Horizon
                  </p>
                </div>
                <div class="ag-barracks-cp-badge">
                  <span id="barracks-hero-stars">★★★★★</span>
                  <strong id="barracks-hero-cp">CP 3,850</strong>
                </div>
              </div>

              <div class="ag-barracks-centerpiece">
                <div id="barracks-paperdoll-stage" class="ag-barracks-sprite-mount"></div>
              </div>

              <div class="ag-barracks-slots-strip" id="barracks-equipment-slots">
                <button
                  type="button"
                  class="ag-equip-slot is-selected"
                  data-equip-slot="WEAPON"
                >
                  <span class="ag-slot-type">Weapon</span>
                  <strong id="slot-label-WEAPON">Starfall Blade</strong>
                </button>
                <button type="button" class="ag-equip-slot" data-equip-slot="OFFHAND">
                  <span class="ag-slot-type">Off-Hand</span>
                  <strong id="slot-label-OFFHAND">Squire Buckler</strong>
                </button>
                <button type="button" class="ag-equip-slot" data-equip-slot="HELMET">
                  <span class="ag-slot-type">Helmet</span>
                  <strong id="slot-label-HELMET">Valkyrie Crown</strong>
                </button>
                <button type="button" class="ag-equip-slot" data-equip-slot="ARMOR">
                  <span class="ag-slot-type">Armor</span>
                  <strong id="slot-label-ARMOR">Valkyrie Plate</strong>
                </button>
                <button type="button" class="ag-equip-slot" data-equip-slot="RELIC_CAPE">
                  <span class="ag-slot-type">Relic / Wings</span>
                  <strong id="slot-label-RELIC_CAPE">Traveler Cloak</strong>
                </button>
              </div>
            </div>

            <!-- Right 360px: Tab Gear Inventory & Tab Stats & Skill -->
            <aside class="ag-barracks-inspector-col">
              <div class="ag-subtab-bar" role="tablist">
                <button
                  type="button"
                  class="ag-subtab-btn is-active"
                  data-barracks-tab="gear"
                  role="tab"
                  aria-selected="true"
                >
                  Gear Inventory
                </button>
                <button
                  type="button"
                  class="ag-subtab-btn"
                  data-barracks-tab="stats"
                  role="tab"
                  aria-selected="false"
                >
                  Stats &amp; Skill
                </button>
              </div>

              <div id="barracks-panel-gear" class="ag-barracks-subpanel">
                <div class="ag-gear-panel-head">
                  <span id="barracks-active-slot-title">Pilihan Slot: Weapon</span>
                  <button type="button" id="barracks-unequip-btn" class="ag-mini-btn">
                    Lepas Slot
                  </button>
                </div>
                <div id="barracks-gear-list" class="ag-barracks-gear-list"></div>
                <div id="barracks-item-comparison" class="ag-item-comparison-box"></div>
              </div>

              <div id="barracks-panel-stats" class="ag-barracks-subpanel" hidden>
                <div id="barracks-stats-breakdown" class="ag-stats-breakdown"></div>
              </div>
            </aside>
          </div>
        </section>

        <!-- SCENE 4: GRIMOIRE -->
        <section class="ag-scene" id="scene-grimoire" data-scene-panel="grimoire" hidden>
          <div class="ag-grimoire-layout">
            <header class="ag-grimoire-header">
              <div>
                <span class="ag-kicker">GRAND ARCHIVE &amp; BLACKSMITH</span>
                <h2 class="ag-serif-title">Grimoire Koleksi &amp; Tempa Pusaka</h2>
              </div>
              <div class="ag-subtab-bar" role="tablist">
                <button
                  type="button"
                  class="ag-subtab-btn is-active"
                  data-grimoire-subtab="collection"
                  role="tab"
                  aria-selected="true"
                >
                  Collection Book
                </button>
                <button
                  type="button"
                  class="ag-subtab-btn"
                  data-grimoire-subtab="forge"
                  role="tab"
                  aria-selected="false"
                >
                  Synthesis &amp; Awakening Forge
                </button>
              </div>
            </header>

            <!-- Sub-tab 1: Collection Book -->
            <div id="grimoire-view-collection" class="ag-grimoire-view">
              <div class="ag-collection-progress-strip">
                <div>
                  <span class="ag-kicker">PROGRES ENSIKLOPEDIA</span>
                  <strong id="grimoire-progress-label">10 / 74 Entri Terbuka</strong>
                </div>
                <div class="ag-pity-track">
                  <div id="grimoire-progress-bar" class="ag-pity-fill" style="width: 14%"></div>
                </div>
              </div>

              <div class="ag-grimoire-collection-grid">
                <div class="ag-grimoire-bonds-col">
                  <h3 class="ag-col-title">12 Collection Bonds (Bonus Stat Permanen)</h3>
                  <div id="grimoire-bonds-grid" class="ag-bonds-list"></div>
                </div>

                <div class="ag-grimoire-codex-col">
                  <div class="ag-codex-filter-row">
                    <h3 class="ag-col-title">Galeri 24 Pahlawan &amp; 50 Perlengkapan</h3>
                    <div class="ag-filter-pills">
                      <button
                        type="button"
                        class="ag-filter-pill is-active"
                        data-codex-kind="HEROES"
                      >
                        24 Pahlawan
                      </button>
                      <button type="button" class="ag-filter-pill" data-codex-kind="ITEMS">
                        50 Perlengkapan
                      </button>
                    </div>
                  </div>
                  <div id="grimoire-gallery-grid" class="ag-codex-gallery-grid"></div>
                  <div id="grimoire-showcase-pane" class="ag-codex-showcase-pane"></div>
                </div>
              </div>
            </div>

            <!-- Sub-tab 2: Synthesis & Awakening Forge -->
            <div id="grimoire-view-forge" class="ag-grimoire-view" hidden>
              <div class="ag-forge-two-cols">
                <div class="ag-forge-panel" id="forge-hero-promotion-panel">
                  <span class="ag-kicker">HERO AWAKENING</span>
                  <h3 class="ag-col-title">Promosi Bintang &amp; Pelatihan Pahlawan (★1 → ★5)</h3>
                  <p class="ag-forge-desc">
                    Setiap pahlawan bintang rendah seperti Han Islat (★1) dapat ditempa hingga
                    mencapai derajat ★5 Sovereign.
                  </p>
                  <div id="forge-hero-list" class="ag-forge-list"></div>
                </div>

                <div class="ag-forge-panel" id="forge-equipment-synthesis-panel">
                  <span class="ag-kicker">ANVIL SYNTHESIS</span>
                  <h3 class="ag-col-title">Sintesis 3-ke-1 &amp; Tempa Perlengkapan</h3>
                  <p class="ag-forge-desc">
                    Lebur 3 perlengkapan sejenis atau Starlight Dust di paron pandai besi untuk
                    menempa pusaka dengan bintang lebih tinggi.
                  </p>
                  <div id="forge-anvil-feedback" class="ag-forge-feedback" role="status"></div>
                  <div id="forge-item-list" class="ag-forge-list"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SCENE 5: TRIALS -->
        <section class="ag-scene" id="scene-trials" data-scene-panel="trials" hidden>
          <div class="ag-trials-layout">
            <!-- Left 40%: Tier Kesulitan, Daftar 24 Trial, & Deskripsi -->
            <aside class="ag-trials-left-col">
              <div class="ag-col-header">
                <span class="ag-kicker">RUANG UJIAN LOGIKA RUNE</span>
                <h2 class="ag-serif-title">24 Logic Trials</h2>
              </div>

              <div
                id="trials-tier-tabs"
                class="ag-filter-pills"
                role="group"
                aria-label="Tier Kesulitan Trials"
              >
                <button
                  type="button"
                  class="ag-filter-pill is-active"
                  data-trial-tier="TIER_1_NOVICE"
                >
                  Tier I · Novice (6)
                </button>
                <button type="button" class="ag-filter-pill" data-trial-tier="TIER_2_ADEPT">
                  Tier II · Adept (6)
                </button>
                <button type="button" class="ag-filter-pill" data-trial-tier="TIER_3_MAGUS">
                  Tier III · Magus (6)
                </button>
                <button type="button" class="ag-filter-pill" data-trial-tier="TIER_4_ARCHON">
                  Tier IV · Archon (6)
                </button>
              </div>

              <div id="trials-list" class="ag-trials-list"></div>

              <div class="ag-trial-brief-card">
                <div class="ag-trial-brief-head">
                  <span id="trial-active-code" class="ag-kicker">Trial 01</span>
                  <span id="trial-reward-badge" class="ag-trial-reward-pill">
                    +120 Gems · +2% ATK
                  </span>
                </div>
                <h3 id="trial-active-title" class="ag-col-title">
                  Trial 01 · Zero-Division Ward
                </h3>
                <p id="trial-problem-desc" class="ag-trial-problem-text"></p>
                <div id="trial-example-cases" class="ag-trial-examples"></div>
              </div>
            </aside>

            <!-- Right 60%: Code Editor Monospace Lebar, Nomor Baris, & Console -->
            <div class="ag-trials-right-col">
              <div class="ag-editor-window">
                <div class="ag-editor-topbar">
                  <span id="trial-editor-filename">rune_trial_01.ts</span>
                  <span id="trial-solved-counter">0 / 24 Trials Selesai</span>
                </div>

                <div class="ag-editor-code-area">
                  <ol id="trial-line-numbers" class="ag-line-numbers" aria-hidden="true">
                    <li>1</li>
                    <li>2</li>
                    <li>3</li>
                    <li>4</li>
                  </ol>
                  <pre id="trial-code-display" class="ag-code-pre"></pre>
                </div>

                <div class="ag-editor-options-section">
                  <span class="ag-kicker">PILIH FORMULASI SOLUSI ATAU TULIS KODE RUNE</span>
                  <div id="trial-options-list" class="ag-trial-options-grid"></div>

                  <label class="ag-custom-code-label" for="trial-custom-code">
                    Editor Ekspresi Rune Mandiri (Opsional)
                  </label>
                  <textarea
                    id="trial-custom-code"
                    class="ag-custom-code-textarea"
                    rows="3"
                    placeholder="Ketik ekspresi solusi Anda di sini..."
                  ></textarea>
                </div>

                <div class="ag-editor-actions">
                  <button type="button" id="btn-reset-trial" class="ag-secondary-btn">
                    Reset Kode
                  </button>
                  <button type="button" id="btn-submit-spell" class="ag-primary-gold-btn">
                    Jalankan &amp; Uji Solusi
                  </button>
                </div>
              </div>

              <div class="ag-trial-console" id="trial-console-box">
                <div class="ag-console-header">
                  <span>KONSOL HASIL PENGUJIAN &amp; KASUS UJI</span>
                  <strong id="trial-console-status">Menunggu Eksekusi</strong>
                </div>
                <div id="trial-console-output" class="ag-console-body"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- SCENE 6: ARENA -->
        <section class="ag-scene" id="scene-arena" data-scene-panel="arena" hidden>
          <div class="ag-arena-layout">
            <!-- Top: Wide Battle Stage -->
            <div class="ag-arena-stage-card" id="arena-battle-stage">
              <div class="ag-arena-stage-header">
                <div>
                  <span class="ag-kicker">COLOSSEUM GRAND STAGE</span>
                  <h2 class="ag-serif-title">Gelanggang Pertarungan 1v1</h2>
                </div>
                <div class="ag-arena-stage-controls">
                  <span id="arena-selected-opponent-label" class="ag-arena-matchup-pill">
                    Lawan: Gatekeeper Garruk
                  </span>
                  <button type="button" id="btn-start-auto-duel" class="ag-primary-gold-btn">
                    Mulai Duel
                  </button>
                </div>
              </div>

              <div class="ag-arena-combatants-field">
                <!-- Challenger (Player) Left -->
                <div class="ag-combatant-side ag-combatant-side--left" id="arena-left-card">
                  <div class="ag-combatant-hud">
                    <div class="ag-combatant-name-row">
                      <strong id="arena-left-name">Vanguard_702</strong>
                      <span id="arena-left-cp">CP 3,850</span>
                    </div>
                    <div class="ag-hp-track" aria-label="HP Pemain">
                      <div id="arena-left-hp-bar" class="ag-hp-fill" style="width: 100%"></div>
                    </div>
                    <div class="ag-ult-track" aria-label="Ultimate Pemain">
                      <div id="arena-left-ult-bar" class="ag-ult-fill" style="width: 35%"></div>
                    </div>
                  </div>
                  <div class="ag-combatant-sprite-wrap">
                    <div id="arena-left-sprite" class="ag-arena-sprite"></div>
                    <span id="arena-left-dmg" class="ag-floating-dmg" hidden></span>
                  </div>
                </div>

                <div class="ag-arena-vs-emblem" aria-hidden="true">VS</div>

                <!-- Defender (Opponent) Right -->
                <div class="ag-combatant-side ag-combatant-side--right" id="arena-right-card">
                  <div class="ag-combatant-hud">
                    <div class="ag-combatant-name-row">
                      <strong id="arena-right-name">Gatekeeper Garruk</strong>
                      <span id="arena-right-cp">CP 2,890</span>
                    </div>
                    <div class="ag-hp-track" aria-label="HP Lawan">
                      <div id="arena-right-hp-bar" class="ag-hp-fill ag-hp-fill--foe" style="width: 100%"></div>
                    </div>
                    <div class="ag-ult-track" aria-label="Ultimate Lawan">
                      <div id="arena-right-ult-bar" class="ag-ult-fill" style="width: 20%"></div>
                    </div>
                  </div>
                  <div class="ag-combatant-sprite-wrap">
                    <div id="arena-right-sprite" class="ag-arena-sprite ag-arena-sprite--flipped"></div>
                    <span id="arena-right-dmg" class="ag-floating-dmg" hidden></span>
                  </div>
                </div>
              </div>

              <div id="arena-battle-log" class="ag-arena-battle-log" aria-live="polite">
                Pilih penjaga menara atau hunter di papan peringkat bawah, lalu tekan Mulai Duel.
              </div>
            </div>

            <!-- Bottom: Responsive Leaderboard Table -->
            <div class="ag-arena-leaderboard-card">
              <div class="ag-leaderboard-head">
                <h3 id="arena-leaderboard-caption" class="ag-col-title">
                  Papan Peringkat Colosseum
                </h3>
                <span id="arena-player-standing" class="ag-kicker">
                  Peringkat Anda: Menghitung...
                </span>
              </div>

              <div
                tabindex="0"
                role="region"
                aria-labelledby="arena-leaderboard-caption"
                class="table-wrapper ag-leaderboard-table-wrapper"
              >
                <table class="ag-leaderboard-table">
                  <thead>
                    <tr>
                      <th scope="col">Rank</th>
                      <th scope="col">Hunter &amp; Pahlawan</th>
                      <th scope="col">Gelar</th>
                      <th scope="col">Senjata Utama</th>
                      <th scope="col">Trials</th>
                      <th scope="col">Combat Power</th>
                      <th scope="col">Skor Arena</th>
                      <th scope="col">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="arena-leaderboard-tbody"></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <!-- SUMMON RATES MODAL (Native <dialog> per modern-web-guidance) -->
    <dialog
      id="ag-rates-dialog"
      class="ag-rates-dialog"
      closedby="any"
      aria-labelledby="ag-rates-dialog-title"
    >
      <div class="ag-dialog-inner">
        <div class="ag-dialog-head">
          <h2 id="ag-rates-dialog-title" class="ag-serif-title">
            Daftar Pusaka &amp; Rincian Peluang Pemanggilan
          </h2>
          <form method="dialog">
            <button type="submit" value="close" class="ag-secondary-btn" autofocus>
              Tutup
            </button>
          </form>
        </div>
        <div class="ag-rates-grid">
          <div class="ag-rate-tier">
            <strong>★5 Sovereign Mythic (Peluang Dasar 4.0% · Jaminan 100% di Tarikan ke-50)</strong>
            <p>
              Evelyn (Dawn Blade), Zephyr (Astral Archon), Kaelthas (Solar Sovereign), Ryuzen (Void
              Katana), Aerith (Starlight Saint), Nexus (Cyber Valkyrie), beserta 10 Pusaka ★5.
            </p>
          </div>
          <div class="ag-rate-tier">
            <strong>★4 Grand Epic (Peluang Dasar 16.0% · Dijamin Minimal 1 setiap 10x Panggil)</strong>
            <p>6 Pahlawan ★4 Ordo Ksatria dan 15 Perlengkapan Tempur ★4.</p>
          </div>
          <div class="ag-rate-tier">
            <strong>★3 Guild Rare (Peluang Dasar 36.0%)</strong>
            <p>6 Pahlawan ★3 Penjaga Menara dan 15 Perlengkapan ★3.</p>
          </div>
          <div class="ag-rate-tier">
            <strong>★1–★2 Initiate &amp; Vanguard Squire (Peluang Dasar 44.0%)</strong>
            <p>
              Termasuk Han Islat, Spire Squire (★1) yang dapat dipromosikan hingga ★5 Sovereign di
              Grimoire Forge.
            </p>
          </div>
        </div>
      </div>
    </dialog>

    <!-- GACHA CINEMATIC REVEAL OVERLAY -->
    <div
      id="gacha-cinematic-overlay"
      class="gacha-cinematic-overlay"
      aria-hidden="true"
    >
      <div class="gacha-reveal-modal">
        <div class="gacha-beam-stage">
          <div id="gacha-beam-core" class="gacha-beam-core" data-rarity="5"></div>
        </div>
        <h3 id="gacha-reveal-headline" class="ag-serif-title">Hasil Pemanggilan Altar</h3>
        <div id="gacha-drop-cards-grid" class="gacha-drop-cards-grid"></div>
        <button type="button" id="gacha-close-overlay-btn" class="ag-primary-gold-btn">
          Simpan ke Barak &amp; Lanjutkan
        </button>
      </div>
    </div>

    <script>
      import { bootAethelgradUniverse } from '../../world-aethelgrad/client/aethelgrad-app.ts';
      bootAethelgradUniverse();
    </script>
  </body>
</html>
