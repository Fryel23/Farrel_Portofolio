---
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertV13ContentIntegrity } from '../../data/content-integrity.js';
import {
  getCodexDomainInfo,
  CODEX_MATURITY_CRITERIA,
} from '../../lib/codex-taxonomy.ts';
import {
  buildCodexKnowledgeGraph,
  getCodexRouteSlug,
} from '../../lib/codex-graph-builder.ts';
import '../../styles/codex.css';

export async function getStaticPaths() {
  const workEntries = await getCollection('work');
  const adrEntries = await getCollection('adr');
  const rawCodexEntries = await getCollection('codex');

  const projectRoot = process.cwd();
  const existingSourcePaths = new Set<string>();
  const sourceHashesByPath = new Map<string, string>();

  for (const entry of adrEntries) {
    const relPath = entry.data.provenance.sourcePath;
    const candidate = path.resolve(projectRoot, relPath);
    if (fs.existsSync(candidate) && fs.statSync(candidate).isFile()) {
      existingSourcePaths.add(relPath);
      const sha = crypto.createHash('sha256').update(fs.readFileSync(candidate)).digest('hex');
      sourceHashesByPath.set(relPath, sha);
    }
  }

  for (const entry of rawCodexEntries) {
    for (const sf of entry.data.sourceFiles) {
      const candidate = path.resolve(projectRoot, sf);
      if (fs.existsSync(candidate) && fs.statSync(candidate).isFile()) {
        existingSourcePaths.add(sf);
      }
    }
    for (const ev of entry.data.sourceEvidence) {
      const candidate = path.resolve(projectRoot, ev.file);
      if (fs.existsSync(candidate) && fs.statSync(candidate).isFile()) {
        existingSourcePaths.add(ev.file);
      }
    }
  }

  assertV13ContentIntegrity({
    workEntries,
    adrEntries,
    codexEntries: rawCodexEntries,
    existingSourcePaths,
    source: 'codex/[...slug].astro getStaticPaths',
  });

  const sortedCodex = [...rawCodexEntries].sort((a, b) =>
    a.data.decimalCode.localeCompare(b.data.decimalCode, undefined, { numeric: true })
  );

  const graph = buildCodexKnowledgeGraph({
    codexEntries: sortedCodex,
    workEntries,
    adrEntries,
  });

  return sortedCodex.map((entry, idx) => {
    const prevEntry = idx > 0 ? sortedCodex[idx - 1] : null;
    const nextEntry = idx < sortedCodex.length - 1 ? sortedCodex[idx + 1] : null;
    const nodeId = `codex:${entry.data.codexId}`;

    return {
      params: { slug: getCodexRouteSlug(entry.id) },
      props: {
        entry,
        prevEntry,
        nextEntry,
        outgoingRefs: graph.outgoingByNodeId[nodeId] || [],
        incomingBacklinks: graph.incomingBacklinksByNodeId[nodeId] || [],
      },
    };
  });
}

const { entry, prevEntry, nextEntry, outgoingRefs, incomingBacklinks } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const domainInfo = getCodexDomainInfo(d.domain);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const formulas = d.formulas || [];
---

<BaseLayout
  title={`${d.decimalCode} · ${d.title} · The Grand Codex`}
  description={d.summary}
  pageKey="codex-detail"
>
  <article class="container codex-page" aria-labelledby="codex-detail-title">
    <nav class="codex-kicker" aria-label="Breadcrumb">
      <a href="/archive" style="color: inherit; text-decoration: none;">Archive</a>
      <span aria-hidden="true">/</span>
      <a href="/codex" style="color: inherit; text-decoration: none;">The Grand Codex</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{d.decimalCode}</span>
    </nav>

    <header class="codex-hero">
      <div class="codex-card-top" style="justify-content: flex-start; gap: 0.75rem; margin-bottom: 1rem;">
        <span class="codex-decimal-badge">DECIMAL {d.decimalCode}</span>
        <span class={`codex-maturity-badge codex-maturity-badge--${d.maturity}`}>
          MATURITY: {d.maturity}
        </span>
        {domainInfo && (
          <span class="codex-maturity-badge">
            DOMAIN {domainInfo.code}: {domainInfo.label}
          </span>
        )}
        <span class="codex-maturity-badge">UPDATED: {d.updatedAt}</span>
      </div>

      <h1 class="codex-title" id="codex-detail-title">{d.title}</h1>
      <p class="codex-lead">{d.summary}</p>
      <p style="font-family: var(--mono); font-size: 0.78rem; color: var(--text-3); margin: 0.75rem 0 0;">
        Kriteria {d.maturity}: {CODEX_MATURITY_CRITERIA[d.maturity]}
      </p>
    </header>

    <div class="codex-detail-layout">
      <!-- Sticky Sidebar: TOC + Verified Source Files -->
      <aside class="codex-sidebar" aria-label="Navigasi bagian dan berkas sumber">
        <section class="codex-panel" aria-labelledby="codex-toc-heading">
          <h2 class="codex-panel-title" id="codex-toc-heading">TABLE OF CONTENTS</h2>
          {tocHeadings.length > 0 ? (
            <ol class="codex-toc-list" role="list">
              {tocHeadings.map((h) => (
                <li>
                  <a
                    class={`codex-toc-link ${h.depth === 3 ? 'codex-toc-link--h3' : ''}`}
                    href={`#${h.slug}`}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p style="font-size: 0.84rem; color: var(--text-3); margin: 0;">
              Catatan ini disajikan dalam satu bagian terpadu.
            </p>
          )}
        </section>

        <section class="codex-panel" aria-labelledby="codex-sources-heading">
          <h2 class="codex-panel-title" id="codex-sources-heading">
            VERIFIED REPOSITORY SOURCES ({d.sourceFiles.length})
          </h2>
          <ul class="codex-toc-list" role="list">
            {d.sourceFiles.map((filePath) => (
              <li style="font-family: var(--mono); font-size: 0.76rem; word-break: break-all; color: var(--ink);">
                <code>{filePath}</code>
              </li>
            ))}
          </ul>
        </section>
      </aside>

      <!-- Main Content Column -->
      <div>
        <!-- Static Native MathML Formula Panel (Zero External Runtime Dependency) -->
        {formulas.length > 0 && (
          <section class="codex-formula-section" aria-labelledby="codex-formula-panel-heading">
            <h2 class="codex-panel-title" id="codex-formula-panel-heading">
              FORMAL EQUATIONS &amp; NATIVE MATHML SPECIFICATION
            </h2>
            {formulas.map((f, idx) => {
              const statusId = `formula-copy-status-${idx}`;
              return (
                <div class="codex-formula-card">
                  <h3 style="font-size: 1.05rem; margin: 0 0 0.45rem; color: var(--ink);">
                    {f.label}
                  </h3>
                  <p style="font-size: 0.9rem; color: var(--text-2); margin: 0 0 0.75rem;">
                    {f.plainExplanation}
                  </p>

                  <!-- Static Native MathML authored explicitly per mathmlKind -->
                  {(f.mathmlKind === 'sample-stride' || f.mathmlKind === 'csv-sampling-stride') && (
                    <div class="codex-formula-mathml" role="math" aria-label={f.plainExplanation}>
                      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                        <mrow>
                          <mi>s</mi>
                          <mo>=</mo>
                          <mrow>
                            <mo>&#x2308;</mo>
                            <mfrac>
                              <mi>N</mi>
                              <msub>
                                <mi>M</mi>
                                <mtext>max</mtext>
                              </msub>
                            </mfrac>
                            <mo>&#x2309;</mo>
                          </mrow>
                          <mspace width="1.2em" />
                          <mo>,</mo>
                          <mspace width="1.2em" />
                          <msub>
                            <mi>M</mi>
                            <mtext>max</mtext>
                          </msub>
                          <mo>=</mo>
                          <mn>5000</mn>
                        </mrow>
                      </math>
                    </div>
                  )}

                  {f.mathmlKind === 'fresnel-view-space' && (
                    <div class="codex-formula-mathml" role="math" aria-label={f.plainExplanation}>
                      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                        <mrow>
                          <mi>F</mi>
                          <mo>=</mo>
                          <msup>
                            <mrow>
                              <mo>(</mo>
                              <mrow>
                                <mn>1.0</mn>
                                <mo>-</mo>
                                <mi>max</mi>
                                <mo>&#x2061;</mo>
                                <mrow>
                                  <mo>(</mo>
                                  <mrow>
                                    <mover>
                                      <mi>N</mi>
                                      <mo>^</mo>
                                    </mover>
                                    <mo>&#x22C5;</mo>
                                    <mover>
                                      <mi>V</mi>
                                      <mo>^</mo>
                                    </mover>
                                    <mo>,</mo>
                                    <mn>0.0</mn>
                                  </mrow>
                                  <mo>)</mo>
                                </mrow>
                              </mrow>
                              <mo>)</mo>
                            </mrow>
                            <mi>p</mi>
                          </msup>
                        </mrow>
                      </math>
                    </div>
                  )}

                  {f.mathmlKind === 'ispu-linear-interpolation' && (
                    <div class="codex-formula-mathml" role="math" aria-label={f.plainExplanation}>
                      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                        <mrow>
                          <mi>I</mi>
                          <mo>=</mo>
                          <mfrac>
                            <mrow>
                              <msub>
                                <mi>I</mi>
                                <mi>a</mi>
                              </msub>
                              <mo>-</mo>
                              <msub>
                                <mi>I</mi>
                                <mi>b</mi>
                              </msub>
                            </mrow>
                            <mrow>
                              <msub>
                                <mi>X</mi>
                                <mi>a</mi>
                              </msub>
                              <mo>-</mo>
                              <msub>
                                <mi>X</mi>
                                <mi>b</mi>
                              </msub>
                            </mrow>
                          </mfrac>
                          <mo>&#x22C5;</mo>
                          <mrow>
                            <mo>(</mo>
                            <mrow>
                              <msub>
                                <mi>X</mi>
                                <mi>x</mi>
                              </msub>
                              <mo>-</mo>
                              <msub>
                                <mi>X</mi>
                                <mi>b</mi>
                              </msub>
                            </mrow>
                            <mo>)</mo>
                          </mrow>
                          <mo>+</mo>
                          <msub>
                            <mi>I</mi>
                            <mi>b</mi>
                          </msub>
                        </mrow>
                      </math>
                    </div>
                  )}

                  <!-- Source Notation Fallback Bar -->
                  <div class="codex-formula-notation-bar">
                    <div>
                      <span style="color: var(--text-3); margin-right: 0.5rem;">SOURCE NOTATION:</span>
                      <code>{f.sourceNotation}</code>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.6rem;">
                      <span
                        id={statusId}
                        role="status"
                        aria-live="polite"
                        style="font-size: 0.72rem; color: var(--blue);"
                      ></span>
                      <button
                        type="button"
                        class="codex-copy-btn"
                        data-copy-formula={f.sourceNotation}
                        data-status-target={statusId}
                      >
                        Copy Notation
                      </button>
                    </div>
                  </div>

                  {f.variables && f.variables.length > 0 && (
                    <table class="codex-evidence-table" aria-label={`Variabel formula ${f.label}`}>
                      <thead>
                        <tr>
                          <th>Symbol</th>
                          <th>Definition</th>
                          <th>Unit</th>
                        </tr>
                      </thead>
                      <tbody>
                        {f.variables.map((v) => (
                          <tr>
                            <td><code>{v.symbol}</code></td>
                            <td>{v.meaning}</td>
                            <td>{v.unit || '-'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                </div>
              );
            })}
          </section>
        )}

        <!-- Main Markdown Prose -->
        <div class="codex-article">
          <div class="codex-prose">
            <Content />
          </div>

          <!-- Source Evidence Audit Table -->
          <section style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-strong);" aria-labelledby="codex-evidence-heading">
            <h2 class="codex-panel-title" id="codex-evidence-heading">
              REPOSITORY EVIDENCE MATRIX ({d.sourceEvidence.length} VERIFIED CLAIMS)
            </h2>
            <table class="codex-evidence-table">
              <thead>
                <tr>
                  <th>Source File</th>
                  <th>Symbol / Section Reference</th>
                  <th>Evidence Status</th>
                  <th>Claim &amp; Verification</th>
                </tr>
              </thead>
              <tbody>
                {d.sourceEvidence.map((ev) => (
                  <tr>
                    <td><code>{ev.file}</code></td>
                    <td><code>{ev.reference}</code></td>
                    <td><strong>{ev.status}</strong></td>
                    <td>
                      {ev.claim}
                      {ev.verifiedBy && (
                        <div style="font-family: var(--mono); font-size: 0.72rem; color: var(--text-3); margin-top: 0.25rem;">
                          Verified by: <code>{ev.verifiedBy}</code>
                        </div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <!-- Cross-Collection Outgoing Relations & Incoming Backlinks -->
          <section class="codex-relations-grid" aria-label="Relasi lintas koleksi dan backlink">
            <div class="codex-panel">
              <h2 class="codex-panel-title">
                OUTGOING REFERENCES ({outgoingRefs.length})
              </h2>
              {outgoingRefs.length > 0 ? (
                <ul class="codex-graph-node-list" role="list">
                  {outgoingRefs.map((ref) => (
                    <li class="codex-graph-node-item">
                      <div class="codex-graph-node-top">
                        <span>
                          <strong>{ref.codeOrTag}</strong> · {ref.type.toUpperCase()}
                        </span>
                        <span>{ref.relationType}</span>
                      </div>
                      {ref.routeable && ref.url ? (
                        <a class="codex-graph-node-link" href={ref.url}>
                          {ref.label}
                        </a>
                      ) : (
                        <div>
                          <span class="codex-graph-node-refonly">{ref.label}</span>
                          <div style="margin-top: 0.25rem;">
                            <span class="codex-refonly-badge">
                              REFERENCE-ONLY ({ref.statusOrMaturity} · NON-ROUTEABLE)
                            </span>
                          </div>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p style="font-size: 0.85rem; color: var(--text-3); margin: 0;">
                  Tidak ada referensi keluar pada catatan ini.
                </p>
              )}
            </div>

            <div class="codex-panel">
              <h2 class="codex-panel-title">
                INCOMING BACKLINKS ({incomingBacklinks.length})
              </h2>
              {incomingBacklinks.length > 0 ? (
                <ul class="codex-graph-node-list" role="list">
                  {incomingBacklinks.map((backlink) => (
                    <li class="codex-graph-node-item">
                      <div class="codex-graph-node-top">
                        <span>
                          <strong>{backlink.codeOrTag}</strong> · {backlink.type.toUpperCase()}
                        </span>
                        <span>BACKLINK</span>
                      </div>
                      {backlink.routeable && backlink.url ? (
                        <a class="codex-graph-node-link" href={backlink.url}>
                          {backlink.label}
                        </a>
                      ) : (
                        <span class="codex-graph-node-refonly">{backlink.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p style="font-size: 0.85rem; color: var(--text-3); margin: 0;">
                  Belum ada catatan lain yang merujuk langsung ke simpul ini.
                </p>
              )}
            </div>
          </section>
        </div>

        <!-- Prev / Next Decimal Sequence Navigation -->
        <nav
          class="codex-relations-grid"
          style="margin-top: 1.5rem;"
          aria-label="Navigasi urutan desimal The Grand Codex"
        >
          {prevEntry ? (
            <a
              class="codex-panel"
              style="text-decoration: none; color: inherit;"
              href={`/codex/${getCodexRouteSlug(prevEntry.id)}`}
            >
              <span class="codex-panel-title" style="display: block;">
                ← PREVIOUS NOTE ({prevEntry.data.decimalCode})
              </span>
              <strong style="color: var(--ink);">{prevEntry.data.title}</strong>
            </a>
          ) : (
            <div class="codex-panel" aria-disabled="true" style="opacity: 0.65;">
              <span class="codex-panel-title" style="display: block;">START OF CODEX</span>
              <span>Catatan pertama dalam urutan desimal 100-600</span>
            </div>
          )}

          {nextEntry ? (
            <a
              class="codex-panel"
              style="text-decoration: none; color: inherit;"
              href={`/codex/${getCodexRouteSlug(nextEntry.id)}`}
            >
              <span class="codex-panel-title" style="display: block;">
                NEXT NOTE ({nextEntry.data.decimalCode}) →
              </span>
              <strong style="color: var(--ink);">{nextEntry.data.title}</strong>
            </a>
          ) : (
            <div class="codex-panel" aria-disabled="true" style="opacity: 0.65;">
              <span class="codex-panel-title" style="display: block;">END OF CODEX</span>
              <span>Catatan terakhir dalam urutan desimal 100-600</span>
            </div>
          )}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  import '../../scripts/codex.js';
</script>
