---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/archive.css';
---

<BaseLayout
  title="Credentials · Farrel Islami Putra"
  pageKey="archive-credentials"
  description="Milestones dan credentials Farrel Islami Putra: slot sertifikat, penghargaan, dan publikasi yang akan terisi saat buktinya benar-benar ada. Tidak ada yang dipamerkan sebelum ada buktinya."
>
  <!-- ============ MILESTONES & CREDENTIALS ============ -->
  <section class="credentials-section" id="credentials" aria-labelledby="credentials-heading">
    <div class="section-inner credentials-inner">
      <div class="ornament ornament-credentials-watermark" aria-hidden="true">
        <svg viewBox="0 0 200 200" xmlns:xlink="http://www.w3.org/1999/xlink" focusable="false">
          <defs>
            <path id="ornament-credentials-arc" d="M 100,100 m -80,0 a 80,80 0 1,1 160,0 a 80,80 0 1,1 -160,0" />
          </defs>
          <text fill="currentColor" font-size="10" letter-spacing="3">
            <textPath href="#ornament-credentials-arc" xlink:href="#ornament-credentials-arc" startOffset="0">ARCHIVE / CREDENTIALS / ARCHIVE / CREDENTIALS / </textPath>
          </text>
        </svg>
      </div>
      <div class="section-heading">
        <div>
          <p class="section-kicker">ARC-04 · CREDENTIALS</p>
          <h1 class="display-heading" id="credentials-heading">
            <span class="line-mask"><span class="line">Bukti karya,</span></span>
            <span class="line-mask"><span class="line">sedang <em>bertumbuh.</em></span></span>
          </h1>
        </div>
        <p class="heading-aside" id="credentials-intro">Sertifikat, penghargaan, dan publikasi hanya akan diarsipkan di halaman ini setelah benar-benar diperoleh dan dapat diverifikasi. Tidak ada klaim yang ditampilkan sebelum ada buktinya.</p>
      </div>

      <div class="credential-grid" id="credential-grid">
        <!-- Static empty state (script menggantinya saat entri nyata ada
             di data). Frame ini slot cadangan, bukan kredensial. -->
        <div class="credential-slot">
          <span class="credential-slot-type">CERTIFICATE</span>
          <span class="credential-slot-label">COMING SOON</span>
          <span class="credential-slot-note">RESERVED FOR FUTURE ENTRIES</span>
        </div>
        <div class="credential-slot">
          <span class="credential-slot-type">AWARD</span>
          <span class="credential-slot-label">COMING SOON</span>
          <span class="credential-slot-note">RESERVED FOR FUTURE ENTRIES</span>
        </div>
        <div class="credential-slot">
          <span class="credential-slot-type">PUBLICATION</span>
          <span class="credential-slot-label">COMING SOON</span>
          <span class="credential-slot-note">RESERVED FOR FUTURE ENTRIES</span>
        </div>
      </div>

      <p class="credentials-footnote">ONLY EARNED, VERIFIED CREDENTIALS <span>ARE ADDED THROUGH SOURCE CODE / SEE README</span></p>
    </div>
  </section>

  <!-- Credential preview dialog (12.6): hanya diisi dari entri nyata dan
       terverifikasi. Kosong sekarang: tidak pernah tampil. -->
  <dialog class="credential-dialog" id="credential-dialog" aria-labelledby="credential-dialog-title">
    <div class="credential-dialog-inner">
      <button class="dialog-close" id="credential-dialog-close" type="button" aria-label="Close preview">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <figure class="credential-dialog-figure">
        <img id="credential-dialog-image" alt="" />
      </figure>
      <div class="credential-dialog-meta">
        <span class="credential-type" id="credential-dialog-type"></span>
        <h3 id="credential-dialog-title"></h3>
        <p class="credential-dialog-issuer" id="credential-dialog-issuer"></p>
        <p class="credential-dialog-id" id="credential-dialog-id"></p>
        <a class="credential-proof" id="credential-dialog-proof" href="#" target="_blank" rel="noopener noreferrer">
          Verify credential <span class="project-link-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  import '../../scripts/archive.js';
</script>
