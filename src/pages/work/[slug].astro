---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import '../../styles/work.css';
import CaseNarrative from '../../components/work/CaseNarrative.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import '../../styles/case-narrative.css';
import { getCollection, render } from 'astro:content';
import { assertWorkIntegrity } from '../../data/content-integrity.js';
import { DISCIPLINES, TECHNOLOGIES, taxonomyLabel } from '../../data/taxonomy.js';

export async function getStaticPaths() {
  const allEntries = await getCollection('work');
  assertWorkIntegrity(allEntries, 'work/[slug].astro getStaticPaths');

  const entries = allEntries
    .filter(({ data }) => data.status !== 'RESERVED')
    .sort((a, b) => a.id.localeCompare(b.id));
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, number: String(index + 1).padStart(2, '0') },
  }));
}

const { entry, number } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const allWork = await getCollection('work');
const entryByContentId = new Map(allWork.map((candidate) => [candidate.data.contentId, candidate]));
const relatedEntries = d.relatedIds
  .map((contentId) => entryByContentId.get(contentId))
  .filter((candidate) => Boolean(candidate));

const disciplineChips = d.disciplines.map((id) => taxonomyLabel(DISCIPLINES, id)).filter(Boolean);
const technologyChips = d.technologies.map((id) => taxonomyLabel(TECHNOLOGIES, id)).filter(Boolean);
const hasTaxonomyChips = disciplineChips.length > 0 || technologyChips.length > 0;
---

<BaseLayout title={`${d.title} · Farrel Islami Putra`} description={d.description} pageKey="work-detail">
  <article class="case-study" aria-labelledby="case-title">
    <div class="case-study-inner">
      <p class="section-kicker">{d.kicker || `${number} / CASE STUDY`}</p>
      <h1 class="case-study-title" id="case-title">
        <span class="line-mask"><span class="line">{d.title}</span></span>
      </h1>
      <div class="case-study-meta">
        <span class="case-meta-item"><span class="mini-label">CATEGORY</span>{d.category}</span>
        <span class="case-meta-item"><span class="mini-label">TAG</span>{d.tag}</span>
        <span class="case-meta-item"><span class="mini-label">STATUS</span><span class="project-status">{d.status}</span></span>
        {
          d.stack && d.stack.length > 0 && (
            <span class="case-meta-item">
              <span class="mini-label">STACK</span>
              <span class="project-stack">
                {d.stack.map((tech) => (
                  <span class="stack-chip">{tech}</span>
                ))}
              </span>
            </span>
          )
        }
      </div>

      <aside class="case-digest-bar" aria-label="Intisari cepat studi kasus">
        <div class="case-digest-grid">
          <div class="case-digest-item">
            <span class="case-digest-label">PERIODE DATA</span>
            <strong class="case-digest-value">2021–2025 (2025 parsial Jan–Jun)</strong>
          </div>
          <div class="case-digest-item">
            <span class="case-digest-label">PARAMETER</span>
            <strong class="case-digest-value">ISPU, SO₂, &amp; NO₂ (µg/Nm³)</strong>
          </div>
          <div class="case-digest-item">
            <span class="case-digest-label">CAKUPAN SPASIAL</span>
            <strong class="case-digest-value">23 Titik Pantau DLH Kab. Cirebon</strong>
          </div>
          <div class="case-digest-item">
            <span class="case-digest-label">STANDAR ACUAN</span>
            <strong class="case-digest-value">PermenLHK No. P.14/2020</strong>
          </div>
        </div>
        <div class="case-digest-actions">
          <a class="button button-primary" href="/lab">Coba Penjelajah Interaktif (/lab) <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="/lab/methodology">Rincian Metodologi ISPU (/lab/methodology) <span aria-hidden="true">→</span></a>
        </div>
      </aside>

      {
        d.image && (
          <div class="case-study-cover" transition:name={`project-image-${entry.id}`}>
            <img src={d.image} alt={`${d.title}: project cover illustration`} loading="eager" decoding="async" data-opening-critical />
          </div>
        )
      }

      <CaseNarrative narrative={d.narrative} />

      <div class="case-study-columns">
        <aside class="case-sticky-aside" aria-label="Navigasi bab studi kasus">
          <nav class="case-sticky-nav">
            <p class="case-sticky-kicker">DAFTAR BAB · CHAPTER INDEX</p>
            <ol class="case-sticky-list">
              {d.context && <li><a href="#case-context-title"><span>01</span> Konteks Masalah</a></li>}
              <li><a href="#case-prose-section"><span>02</span> Narasi &amp; Analisis</a></li>
              {d.methodology && d.methodology.length > 0 && <li><a href="#case-methodology-title"><span>03</span> Metodologi</a></li>}
              {d.findings && d.findings.length > 0 && <li><a href="#case-findings-title"><span>04</span> Temuan Utama</a></li>}
              {d.limitations && d.limitations.length > 0 && <li><a href="#case-limitations-title"><span>05</span> Keterbatasan Jujur</a></li>}
              {hasTaxonomyChips && <li><a href="#case-taxonomy-title"><span>06</span> Klasifikasi Teknis</a></li>}
            </ol>
            <div class="case-sticky-lab-card">
              <span class="case-sticky-kicker">SANDBOX INTERAKTIF</span>
              <p>Uji langsung filter tahun 2021–2025, parameter ISPU/SO₂/NO₂, dan peta 23 stasiun di The Data Lab.</p>
              <a class="case-sticky-lab-link" href="/lab">Buka /lab <span aria-hidden="true">↗</span></a>
            </div>
          </nav>
        </aside>

        <div class="case-reading-column">
          {
            d.context && (
              <section class="case-context" aria-labelledby="case-context-title">
                <h2 class="case-section-title" id="case-context-title">Konteks</h2>
                <p class="case-context-text">{d.context}</p>
              </section>
            )
          }

          <div class="case-study-body prose-archive" id="case-prose-section">
            <Content />
          </div>

          {
            d.methodology && d.methodology.length > 0 && (
              <section class="case-structured" aria-labelledby="case-methodology-title">
                <h2 class="case-section-title" id="case-methodology-title">Metodologi</h2>
                <ol class="case-steps" role="list">
                  {d.methodology.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </section>
            )
          }
          {
            d.findings && d.findings.length > 0 && (
              <section class="case-structured" aria-labelledby="case-findings-title">
                <h2 class="case-section-title" id="case-findings-title">Temuan</h2>
                <ul class="case-notes" role="list">
                  {d.findings.map((finding) => (
                    <li>{finding}</li>
                  ))}
                </ul>
              </section>
            )
          }
          {
            d.limitations && d.limitations.length > 0 && (
              <section class="case-structured" aria-labelledby="case-limitations-title">
                <h2 class="case-section-title" id="case-limitations-title">Keterbatasan</h2>
                <ul class="case-notes" role="list">
                  {d.limitations.map((limitation) => (
                    <li>{limitation}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            hasTaxonomyChips && (
              <section class="case-taxonomy" aria-labelledby="case-taxonomy-title">
                <h2 class="case-section-title" id="case-taxonomy-title">Klasifikasi</h2>
                {disciplineChips.length > 0 && (
                  <div class="case-taxonomy-row">
                    <span class="mini-label">DISCIPLINES</span>
                    <ul class="case-chip-list" role="list">
                      {disciplineChips.map((label) => (
                        <li class="stack-chip">{label}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {technologyChips.length > 0 && (
                  <div class="case-taxonomy-row">
                    <span class="mini-label">TECHNOLOGIES</span>
                    <ul class="case-chip-list" role="list">
                      {technologyChips.map((label) => (
                        <li class="stack-chip">{label}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </section>
            )
          }

          {
            relatedEntries.length > 0 && (
              <section class="case-related" aria-labelledby="case-related-title">
                <h2 class="case-section-title" id="case-related-title">Proyek Terkait</h2>
                <div class="case-related-grid">
                  {relatedEntries.map((relatedEntry, index) => (
                    <ProjectCard
                      project={{ ...relatedEntry.data, id: relatedEntry.id, href: `/work/${relatedEntry.id}` }}
                      index={index}
                    />
                  ))}
                </div>
              </section>
            )}

          <div class="case-study-actions">
            <a class="button button-primary magnetic-button" href="/lab">
              Buka Penjelajah Data AQI (/lab) <span aria-hidden="true">↗</span>
            </a>
            {
              d.link && /^https?:\/\//i.test(d.link) && (
                <a class="button button-outline magnetic-button" href={d.link} target="_blank" rel="noopener noreferrer">
                  {d.linkLabel || 'Buka Dokumentasi Riset'} <span aria-hidden="true">↗</span>
                </a>
              )
            }
            <a class="button button-outline magnetic-button" href="/work">Kembali ke Halaman Proyek <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  import { initCaseNarrative } from '../../scripts/case-narrative.js';
  import { bootPage } from '../../scripts/core.js';

  bootPage({ motion: [initCaseNarrative] });
</script>
