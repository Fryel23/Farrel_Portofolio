---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import '../../styles/work.css';
/* V10.0 FASE 3: panggung naratif 3 scene + stylesheet-nya. */
import CaseNarrative from '../../components/work/CaseNarrative.astro';
import '../../styles/case-narrative.css';
import { getCollection, render } from 'astro:content';

/* V8.1 Fase 4.1: entri berstatus RESERVED tidak pernah menghasilkan
   rute publik. Filter dilakukan di getStaticPaths (bukan di komponen
   halaman) sesuai rekomendasi Astro untuk mengecualikan rute.
   V10.2 B.2: nomor case study di-derive dari indeks getStaticPaths
   (sort deterministik by id) sehingga proyek kedua otomatis "02". */
export async function getStaticPaths() {
  const entries = (await getCollection('work', ({ data }) => data.status !== 'RESERVED'))
    .sort((a, b) => a.id.localeCompare(b.id));
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, number: String(index + 1).padStart(2, '0') },
  }));
}

const { entry, number } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={`${d.title} · Farrel Islami Putra`} description={d.description} pageKey="work-detail">
  <article class="case-study" aria-labelledby="case-title">
    <div class="case-study-inner">
      <p class="section-kicker">{d.kicker || `${number} / CASE STUDY`}</p>
      <h1 class="case-study-title" id="case-title">
        <span class="line-mask"><span class="line">{d.title}</span></span>
      </h1>
      <div class="case-study-meta">
        <span class="case-meta-item"><span class="mini-label">CATEGORY</span>{d.category}</span>
        <span class="case-meta-item"><span class="mini-label">TAG</span>{d.tag}</span>
        <span class="case-meta-item"><span class="mini-label">STATUS</span><span class="project-status">{d.status}</span></span>
        {
          d.stack && d.stack.length > 0 && (
            <span class="case-meta-item">
              <span class="mini-label">STACK</span>
              <span class="project-stack">
                {d.stack.map((tech) => (
                  <span class="stack-chip">{tech}</span>
                ))}
              </span>
            </span>
          )
        }
      </div>

      {
        d.image && (
          <div class="case-study-cover" transition:name={`project-image-${entry.id}`}>
            <!-- V9.0 Batasan 8: cover eager di atas lipatan = aset kritis
                 boot sequence (halaman detail bisa menjadi landing pertama). -->
            <img src={d.image} alt={`${d.title}: project cover illustration`} loading="eager" decoding="async" data-opening-critical />
          </div>
        )
      }

      {/* V10.0 FASE 3: scrollytelling 3 scene (Masalah -> Proses ->
          Temuan) sebagai section full-bleed SAUDARA dari case-study-body
          (bukan di dalamnya): spesifikasi merender panggung sticky
          setinggi 100vh dengan padding clamp(22px, 7vw, 110px) - bila
          diletakkan di dalam .case-study-body, lebar panggung ikut
          terkurung kolom prosa (~720px) dan panggung tidak pernah
          full-bleed. Hanya muncul bila frontmatter punya `narrative`. */}
      <CaseNarrative narrative={d.narrative} />

      <div class="case-study-body prose-archive">
        <Content />
      </div>

      <div class="case-study-actions">
        {
          d.link && /^https?:\/\//i.test(d.link) && (
            <a class="button button-primary magnetic-button" href={d.link} target="_blank" rel="noopener noreferrer">
              {d.linkLabel || 'View project'} <span aria-hidden="true">↗</span>
            </a>
          )
        }
        <a class="button button-outline magnetic-button" href="/work">Back to the archive <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  /* V10.0 FASE 3: narrative dipanggil lewat bootPage halaman (bukan
     top-level) karena modul halaman hanya dieksekusi sekali per sesi;
     bootPage memastikan initCaseNarrative berjalan pada SETIAP
     astro:page-load (navigasi masuk/keluar case study) dan ikut siklus
     cleanup after-swap. Guard elemen di dalam initCaseNarrative
     membuatnya no-op di halaman lain yang memuat modul ini. */
  import { initCaseNarrative } from '../../scripts/case-narrative.js';
  import { bootPage } from '../../scripts/core.js';

  bootPage({ motion: [initCaseNarrative] });
</script>
