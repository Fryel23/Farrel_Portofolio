---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/work.css';

/* Fase 4.2: halaman /work. Filter kategori + grid semua proyek.
   Grid awal dirender statis dari Content Collections (fallback tanpa JS
   identik); interaksi filter tetap memakai renderProjects() dari
   work.js yang membaca DATA (perilaku V6.7 dipertahankan penuh). */
---

<BaseLayout title="Work · Farrel Islami Putra" pageKey="work">
  <section class="gallery-section" id="work" aria-labelledby="gallery-heading">
    <div class="desktop-frame desktop-frame--tl" aria-hidden="true"></div>
    <div class="desktop-frame desktop-frame--br" aria-hidden="true"></div>
    <div class="gallery-curve" aria-hidden="true"></div>
    <div class="section-inner gallery-inner">
      <div class="ornament ornament-gallery-truchet" aria-hidden="true">
        <svg width="100%" height="100%" focusable="false">
          <defs>
            <pattern id="ornament-gallery-truchet-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 0,20 A 20,20 0 0,1 20,0" fill="none" stroke="currentColor" stroke-width="1" />
              <path d="M 40,20 A 20,20 0 0,1 20,40" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#ornament-gallery-truchet-pattern)"></rect>
        </svg>
      </div>
      <div class="ornament ornament-gallery-stamp" aria-hidden="true">ARCHIVE / 01</div>
      <div class="section-heading section-heading-light">
        <div>
          <p class="section-kicker">01 / SELECTED WORKS</p>
          <h2 class="display-heading" id="gallery-heading">
            <span class="line-mask"><span class="line">The project</span></span>
            <span class="line-mask"><span class="line"><em>archive.</em></span></span>
          </h2>
        </div>
        <p class="heading-aside" id="gallery-aside">Satu proyek penelitian yang masih berjalan, satu ide yang tertunda, dan satu rencana kecil untuk ke depan. Semua ditulis apa adanya.</p>
      </div>

      <div class="filter-row">
        <span id="project-count">01 PROJECT</span>
        <div class="filter-controls" id="filter-controls" role="group" aria-label="Filter projects by category"></div>
      </div>

      <div class="gallery-ruler" aria-hidden="true">
        <span>01</span><span>02</span><span>03</span>
      </div>

      <div class="project-grid" id="project-grid" aria-live="polite">
        <p class="reserved-text">Grid proyek dirender oleh JavaScript dari data arsip.</p>
      </div>
      <div class="empty-state" id="empty-state" hidden>No projects match this filter. Reserved slots return with the All work view.</div>

      <div class="gallery-bottom-line"><span>KEEP EXPLORING</span><a href="/archive">ARCHIVE HUB →</a></div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  import '../../scripts/work.js';
</script>
