---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import ReservedCard from '../../components/work/ReservedCard.astro';
import { getCollection } from 'astro:content';
import '../../styles/home.css';
import '../../styles/work.css';

/* Fase 4.2 + perbaikan V7.2 Fase 2: halaman /work. Filter kategori + grid
   semua proyek. Grid awal KINI dirender statis saat build dari Content
   Collections (kartu + slot reserved tampil sejak HTML, tanpa menunggu
   JavaScript), dengan state awal filter "All". Interaksi filter tetap
   memakai renderProjects() dari work.js yang mengganti isi grid dengan
   markup identik (perilaku V6.7 dipertahankan penuh). */
const entries = await getCollection('work');
/* Proyek nyata dulu, lalu slot reserved (urutan sama dengan DATA:
   reserved hanya tampil di view All dan tidak pernah dihitung). */
const projects = entries.filter((e) => e.data.status !== 'RESERVED');
const reserved = entries.filter((e) => e.data.status === 'RESERVED');
---

<BaseLayout
  title="Work · Farrel Islami Putra"
  pageKey="work"
  description="Arsip proyek Farrel Islami Putra: riset kualitas udara Cirebon yang masih berjalan, ide yang tertunda, dan rencana kecil ke depan, lengkap dengan filter kategori."
>
  <section class="gallery-section" id="work" aria-labelledby="gallery-heading">
    <div class="desktop-frame desktop-frame--tl" aria-hidden="true"></div>
    <div class="desktop-frame desktop-frame--br" aria-hidden="true"></div>
    <div class="gallery-curve" aria-hidden="true"></div>
    <div class="section-inner gallery-inner">
      <div class="ornament ornament-gallery-truchet" aria-hidden="true">
        <svg width="100%" height="100%" focusable="false">
          <defs>
            <pattern id="ornament-gallery-truchet-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 0,20 A 20,20 0 0,1 20,0" fill="none" stroke="currentColor" stroke-width="1" />
              <path d="M 40,20 A 20,20 0 0,1 20,40" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#ornament-gallery-truchet-pattern)"></rect>
        </svg>
      </div>
      <div class="ornament ornament-gallery-stamp" aria-hidden="true">ARCHIVE / 01</div>
      <div class="section-heading section-heading-light">
        <div>
          <p class="section-kicker">01 / SELECTED WORKS</p>
          <h1 class="display-heading" id="gallery-heading">
            <span class="line-mask"><span class="line">The project</span></span>
            <span class="line-mask"><span class="line"><em>archive.</em></span></span>
          </h1>
        </div>
        <p class="heading-aside" id="gallery-aside">Satu proyek penelitian yang masih berjalan, satu ide yang tertunda, dan satu rencana kecil untuk ke depan. Semua ditulis apa adanya.</p>
      </div>

      <div class="filter-row">
        <span id="project-count">01 PROJECT</span>
        <div class="filter-controls" id="filter-controls" role="group" aria-label="Filter projects by category"></div>
      </div>

      <div class="gallery-ruler" aria-hidden="true">
        <span>01</span><span>02</span><span>03</span>
      </div>

      <div class="project-grid" id="project-grid" aria-live="polite">
        {/* V7.2: kartu dirender statis saat build (tanpa menunggu JS).
            V7.4: kartu menaut ke halaman case study secara internal
            (href), identik dengan hasil renderProjects() di work.js yang
            kini juga merender "Read case study" untuk proyek ber-slug;
            tautan dataset eksternal tetap ada di halaman detail. */}
        {projects.map((entry, index) => (
          <ProjectCard
            project={{ ...entry.data, id: entry.id, href: `/work/${entry.id}` }}
            index={index}
          />
        ))}
        {reserved.map((entry) => (
          <ReservedCard slot={{ title: entry.data.title, kicker: entry.data.kicker, description: entry.data.description }} />
        ))}
      </div>
      <div class="empty-state" id="empty-state" hidden>No projects match this filter. Reserved slots return with the All work view.</div>

      <div class="gallery-bottom-line"><span>KEEP EXPLORING</span><a href="/archive">ARCHIVE HUB →</a></div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/global.js';
  import '../../scripts/work.js';
</script>
