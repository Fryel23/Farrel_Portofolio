---
/* V7.4 Fase 1: ClientRouter (View Transitions bawaan Astro). Navigasi
   antar halaman kini client-side tanpa reload penuh, tanpa flash layar
   putih. Siklus hidup JavaScript menyesuaikan di core.js (astro:page-load). */
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageKey?: string;
}

const {
  title = 'Farrel Islami Putra · Data, Software & Learning Notes',
  description =
    'Catatan belajar Farrel Islami Putra, mahasiswa Informatika UNIKOM. Soal data, pola, software, dan hal-hal yang belum selesai dipelajari.',
  pageKey = '',
} = Astro.props;

/* V8.1 Fase 3.4: canonical dan og:image absolut memakai Astro.site
   (di-set di astro.config.mjs) sesuai rekomendasi SEO Astro. */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="id" data-page={pageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- V9.0 FASE 1: Zero-FOUC arm sebelum first paint. Script sinkron
         ini berjalan SEBELUM CSS dan SEBELUM body dirender: ia memutus
         apakah Archive Boot Sequence akan tampil (sekali per sesi,
         motion diizinkan) dan menandai html.opening-armed agar guard
         CSS menyembunyikan konten sampai dialog terbuka. Safety timeout
         4s adalah jaring pengaman jika global.js gagal dimuat. Dengan
         JS mati total, script ini tidak jalan -> tanpa class -> tanpa
         guard -> halaman langsung tampil (Skenario 1). -->
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('fip-opening-seen') === '1') return;
          document.documentElement.classList.add('opening-armed');
          window.__openingSafety = setTimeout(function () {
            document.documentElement.classList.remove('opening-armed');
            delete window.__openingSafety;
          }, 4000);
        } catch (e) { /* storage blocked: fallback ke konten langsung */ }
      })();
    </script>
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <!-- V8.1 Fase 3.4: URL absolut untuk canonical, og:url, dan og:image. -->
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- V7.4 Fase 1: router transisi tampilan (wajib di dalam <head>). -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main" lang="en">Skip to content</a>

    <div class="page-progress" aria-hidden="true"><span id="progress-bar"></span></div>

    <Header />

    <!-- V9.0 FASE 1: Archive Boot Sequence berbasis <dialog> native.
         Default browser menutup dialog (tanpa atribut [open]) sehingga
         tanpa JS = tanpa overlay, halaman langsung tampil. showModal()
         memberi focus trap + Escape (event cancel) secara native.
         Dibuka hanya oleh initArchiveOpening (global.js) pada kunjungan
         pertama per sesi saat motion diizinkan. -->
    <dialog class="archive-opening" id="archive-opening" aria-labelledby="opening-label">
      <div class="opening-inner">
        <p class="opening-label" id="opening-label">FIP · PERSONAL ARCHIVE</p>
        <div class="opening-progress-wrap">
          <svg class="opening-ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-bg" cx="50" cy="50" r="46" />
            <circle class="ring-fill" id="opening-ring-fill" cx="50" cy="50" r="46" />
          </svg>
          <div class="opening-counter" id="opening-counter" aria-hidden="true">000</div>
        </div>
        <p class="opening-status" id="opening-status">INITIALIZING...</p>
        <button class="opening-skip" id="opening-skip" type="button">[ ENTER ARCHIVE → ]</button>
      </div>
    </dialog>

    <!-- V7.4 Fase 1: cross-fade halus pada setiap pergantian halaman;
         header, footer, dan overlay opening berada di luar grup fade. -->
    <main id="main" transition:animate="fade">
      <slot />
    </main>

    <Footer />

    <!-- Area status untuk umpan balik copy email (12.7) -->
    <div class="copy-toast" id="copy-toast" role="status" aria-live="polite"></div>

    <!-- V4 §8: page pet mengapung. Tersembunyi sampai dipanggil dari
         section Companion; script.js menyalin SVG pixel-art ke tombol. -->
    <div class="companion-pet" id="companion-pet" hidden>
      <span class="companion-tooltip" id="companion-tooltip" role="status" aria-live="polite" hidden></span>
      <button class="companion-pet-button" id="companion-pet-button" type="button" aria-label="Companion: Kok. Click to say hi."></button>
    </div>

    <!-- Tekstur grain (4.4): dekorasi murni, aria-hidden, pointer-events none. -->
    <svg class="grain-overlay" aria-hidden="true" focusable="false">
      <filter id="grain-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"></feTurbulence>
        <feColorMatrix type="saturate" values="0"></feColorMatrix>
      </filter>
      <rect width="100%" height="100%" filter="url(#grain-filter)"></rect>
    </svg>
  </body>
</html>
