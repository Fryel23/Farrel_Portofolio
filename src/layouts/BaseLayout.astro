---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CommandPalette from '../components/layout/CommandPalette.astro';
import ReferenceDock from '../components/layout/ReferenceDock.astro';
import PortalDiveModal from '../components/layout/PortalDiveModal.astro';
import PageTransitionOverlay from '../components/layout/PageTransitionOverlay.astro';
import '../styles/global.css';
import '../styles/page-transitions.css';

interface Props {
  title?: string;
  description?: string;
  pageKey?: string;
}

const {
  title = 'Farrel Islami Putra · Data, Software & Learning Notes',
  description =
    'Catatan belajar Farrel Islami Putra, mahasiswa Informatika UNIKOM. Soal data, pola, software, dan hal-hal yang belum selesai dipelajari.',
  pageKey = '',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="id" data-page={pageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main" lang="en">Skip to content</a>

    <div class="page-progress" aria-hidden="true"><span id="progress-bar"></span></div>

    <Header />

    <main id="main" transition:animate="fade">
      <slot />
    </main>

    <ReferenceDock />
    <CommandPalette />
    <PortalDiveModal />

    <Footer />

    <div class="copy-toast" id="copy-toast" role="status" aria-live="polite"></div>

    <div class="companion-pet" id="companion-pet" hidden>
      <span class="companion-tooltip" id="companion-tooltip" role="status" aria-live="polite" hidden></span>
      <button class="companion-pet-button" id="companion-pet-button" type="button" aria-label="Companion: Kok. Click to say hi."></button>
    </div>

    <svg class="grain-overlay" aria-hidden="true" focusable="false">
      <filter id="grain-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"></feTurbulence>
        <feColorMatrix type="saturate" values="0"></feColorMatrix>
      </filter>
      <rect width="100%" height="100%" filter="url(#grain-filter)"></rect>
    </svg>

    <PageTransitionOverlay />
  </body>
</html>
