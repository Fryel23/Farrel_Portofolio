---
/* V11.1 STAGE 3: HeroCanvas - pemilik markup untuk dua lapis visual
   signature Hero:
     1. SVG fallback statis (Glass Vessel + F monogram watermark).
        Hadir di initial HTML, terlihat tanpa JavaScript, tanpa
        dynamic import, tanpa network request (fallback-first).
     2. Canvas WebGL (dikendalikan penuh oleh src/scripts/hero-webgl/
        index.js). Canvas default invisible; hanya tampil (fade-in)
        setelah frame valid pertama berhasil dirender.
   Komponen ini TIDAK berisi state machine, resource WebGL, RAF loop,
   shader source, atau lifecycle event (spek §7.1).
   Kontrak ID (spek §7.2): hero-canvas-wrapper / hero-fallback /
   webgl-canvas - konsisten dengan controller dan test. */
---

<div
  class="hero-canvas-wrapper"
  id="hero-canvas-wrapper"
  aria-hidden="true"
  data-webgl-state="fallback"
>
  <!-- Static Glass Vessel illustration (original artwork).
       Silhouette, interior tint, side highlight, cobalt rim line,
       archive measure ticks, dan F monogram watermark (path identik
       dengan public/assets/identity/f-monogram.svg - single source
       of truth §6.3, di-inline agar fallback bebas network). -->
  <svg
    class="hero-fallback-svg"
    id="hero-fallback"
    viewBox="0 0 600 640"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="hv-tint" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2563EB" stop-opacity="0.05"></stop>
        <stop offset="0.55" stop-color="#2563EB" stop-opacity="0.09"></stop>
        <stop offset="1" stop-color="#1E3A8A" stop-opacity="0.13"></stop>
      </linearGradient>
      <linearGradient id="hv-rim" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#93C5FD" stop-opacity="0.85"></stop>
        <stop offset="1" stop-color="#1E3A8A" stop-opacity="0.55"></stop>
      </linearGradient>
      <radialGradient id="hv-sheen" cx="0.32" cy="0.28" r="0.75">
        <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.5"></stop>
        <stop offset="0.55" stop-color="#FFFFFF" stop-opacity="0.08"></stop>
        <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <!-- Grup vessel digeser agar sejajar dengan offset kanan scene WebGL -->
    <g class="hv-vessel" transform="translate(108 0)">
      <!-- Body: silhouette kaca transparan -->
      <path
        d="M224 88 C224 150 210 180 186 224 C152 282 140 320 140 386 C140 470 178 522 226 560 C252 580 268 592 272 606 L328 606 C332 592 348 580 374 560 C422 522 460 470 460 386 C460 320 448 282 414 224 C390 180 376 150 376 88 Z"
        fill="url(#hv-tint)"
        stroke="#2563EB"
        stroke-opacity="0.5"
        stroke-width="1.6"></path>

      <!-- Interior tint: lapisan dalam lebih pekat di dasar -->
      <path
        d="M196 262 C170 316 162 348 162 392 C162 462 194 506 232 540 C256 560 266 574 270 590 L330 590 C334 574 344 560 368 540 C406 506 438 462 438 392 C438 348 430 316 404 262 C420 330 424 356 424 394 C424 456 396 496 362 526 C340 546 330 560 326 576 L274 576 C270 560 260 546 238 526 C204 496 176 456 176 394 C176 356 180 330 196 262 Z"
        fill="#1E3A8A"
        opacity="0.08"></path>

      <!-- Side highlight (kiri) -->
      <path
        d="M212 132 C196 190 170 250 162 320 C156 380 164 440 190 492"
        fill="none"
        stroke="#FFFFFF"
        stroke-opacity="0.55"
        stroke-width="7"
        stroke-linecap="round"
        opacity="0.5"></path>
      <path
        d="M382 140 C396 196 414 254 418 316"
        fill="none"
        stroke="#FFFFFF"
        stroke-opacity="0.3"
        stroke-width="4"
        stroke-linecap="round"
        opacity="0.45"></path>

      <!-- Rim / shoulder terbaca -->
      <ellipse cx="300" cy="80" rx="78" ry="16" fill="url(#hv-rim)" opacity="0.35"></ellipse>
      <ellipse cx="300" cy="80" rx="78" ry="16" fill="none" stroke="#2563EB" stroke-opacity="0.75" stroke-width="2"></ellipse>
      <ellipse cx="300" cy="80" rx="62" ry="10" fill="#1E3A8A" opacity="0.14"></ellipse>
      <!-- Neck ring detail -->
      <path d="M227 132 C260 146 340 146 373 132" fill="none" stroke="#2563EB" stroke-opacity="0.35" stroke-width="1.4"></path>

      <!-- F Monogram watermark (path identik f-monogram.svg) -->
      <g transform="translate(259 296) scale(1.02)" opacity="0.16">
        <path fill="#1E3A8A" d="M17 5h12v43.2l-6.4 8.6L17 54.4Z"></path>
        <path fill="#1E3A8A" d="M17 5h31.6l-5.4 11.4H17Z"></path>
        <path fill="#1E3A8A" d="M17 27.5h25.8l-4.6 10.4H17Z"></path>
        <path fill="#1E3A8A" d="M42.5 46.5h9.5l-9.5 11.2Z" opacity="0.85"></path>
      </g>

      <!-- Archive measure ticks + label (rasa instrumen arsip) -->
      <line x1="132" y1="300" x2="150" y2="300" stroke="#64748B" stroke-width="1" opacity="0.5"></line>
      <line x1="450" y1="300" x2="468" y2="300" stroke="#64748B" stroke-width="1" opacity="0.5"></line>
      <line x1="132" y1="440" x2="146" y2="440" stroke="#64748B" stroke-width="1" opacity="0.35"></line>
      <line x1="454" y1="440" x2="468" y2="440" stroke="#64748B" stroke-width="1" opacity="0.35"></line>
      <text x="128" y="288" font-family="DM Mono, monospace" font-size="9" letter-spacing="2" fill="#64748B" opacity="0.7">VESSEL / 00</text>
      <text x="376" y="626" font-family="DM Mono, monospace" font-size="8" letter-spacing="2" fill="#94A3B8" opacity="0.65">GLASS · CURATED</text>
    </g>
  </svg>

  <canvas
    id="webgl-canvas"
    class="hero-webgl-canvas"
    aria-hidden="true"
    tabindex="-1"
  ></canvas>

  <!-- V11.1 F Monogram watermark overlay (spek §12.2 pilihan resmi:
       overlay SVG dekoratif alih-alih texture WebGL - path identik
       f-monogram.svg, single source of truth §6.3). Tampil HANYA saat
       WebGL ready (menggantikan watermark inline yang ada di fallback);
       kontras rendah, aria-hidden, tanpa tab stop. -->
  <svg
    class="hero-monogram-overlay"
    viewBox="0 0 64 64"
    aria-hidden="true"
    focusable="false"
  >
    <g transform="translate(0 -2)">
      <path fill="#1E3A8A" d="M17 5h12v43.2l-6.4 8.6L17 54.4Z"></path>
      <path fill="#1E3A8A" d="M17 5h31.6l-5.4 11.4H17Z"></path>
      <path fill="#1E3A8A" d="M17 27.5h25.8l-4.6 10.4H17Z"></path>
      <path fill="#1E3A8A" d="M42.5 46.5h9.5l-9.5 11.2Z" opacity="0.85"></path>
    </g>
  </svg>
</div>
