---
/**
 * Header.astro: Header sitewide (V14.0-UNIFIED).
 *
 * Arsitektur Navigasi V14.0:
 *  - 4 item navigasi primer manusiawi di .main-nav:
 *      Beranda (/), Proyek (/work), Tentang (/about), Kontak (/connect)
 *  - Tombol "Eksplorasi ▾" (#menu-dots) membuka Two-Column Progressive
 *    Disclosure Mega-Drawer (#quick-menu / #quick-menu-panel):
 *      Kolom 1 (Explore More): EKSPLORASI INTERAKTIF & ARSIP PERSONAL
 *      Kolom 2 (Technical Archive): ARSIP REKAYASA & DOKUMENTASI SISTEM
 *  - Tombol "Cari / Pintasan · Ctrl+K" (#world-workspace-status-btn)
 *    ramah bagi pengunjung awam dan tetap mempertahankan status wilayah
 *    bagi pengguna mahir.
 */
import { DATA } from '../../data/content.js';

const path = Astro.url.pathname;
const normalize = (p: string) => {
  const cleaned = p.replace(/\/+$/, '');
  return cleaned === '' ? '/' : cleaned;
};
const here = normalize(path);

const NAV = [
  { href: '/', label: 'Beranda', navKey: 'home' },
  { href: '/work', label: 'Proyek', navKey: 'work' },
  { href: '/about', label: 'Tentang', navKey: 'about' },
  { href: '/connect', label: 'Kontak', navKey: 'connect' },
];

const EXPLORE_INTERACTIVE_ITEMS = [
  {
    label: 'Data Lab · AQI Explorer',
    href: '/lab',
    desc: 'Visualisasi interaktif kualitas udara Cirebon 2021–2025.',
    badge: 'LAB',
  },
  {
    label: 'CSV Explorer',
    href: '/lab/csv',
    desc: 'Unggah & analisis statistik file CSV langsung di browser.',
    badge: 'TOOL',
  },
  {
    label: 'Game Deck',
    href: '/archive/play',
    desc: 'Kartu arcade interaktif dari game yang saya mainkan.',
    badge: 'ARC-03',
  },
  {
    label: 'Off-screen & Hobi',
    href: '/archive/off-screen',
    desc: 'Musik, badminton, dan pixel companion.',
    badge: 'ARC-05',
  },
  {
    label: 'Credentials',
    href: '/archive/credentials',
    desc: 'Ruang arsip sertifikat & pencapaian.',
    badge: 'ARC-04',
  },
  {
    label: 'Indeks Arsip Lengkap',
    href: '/archive',
    desc: 'Direktori seluruh studi kasus, tool, dan dokumentasi.',
    badge: 'ARC-HUB',
  },
];

const TECHNICAL_ARCHIVE_ITEMS = [
  {
    label: 'Catatan Teknis (Codex)',
    href: '/codex',
    desc: 'Catatan rekayasa, rumus ISPU, dan graf konsep.',
    badge: '100-600',
  },
  {
    label: 'Arsip Keputusan (ADR)',
    href: '/archive/adr',
    desc: '13 dokumen riwayat eksperimen & keputusan teknis.',
    badge: 'ARC-01',
  },
  {
    label: 'Peta Sistem (Atlas)',
    href: '/atlas',
    desc: 'Diagram topologi arsitektur situs.',
    badge: 'ATLAS',
  },
  {
    label: 'Metodologi AQI',
    href: '/lab/methodology',
    desc: 'Penjelasan rumus PermenLHK P.14/2020.',
    badge: 'METHOD',
  },
  {
    label: 'GitHub Repository',
    href: DATA.links.githubRepo || 'https://github.com/Fryel23/Farrel_Portofolio',
    desc: 'Kode sumber portofolio (@Fryel23 & @Fryel32).',
    badge: 'EXT ↗',
    external: true,
  },
  {
    label: 'Google Drive Docs',
    href: DATA.links.docs,
    desc: 'Folder terbuka lembar kerja & log belajar.',
    badge: 'DRIVE ↗',
    external: true,
  },
];

function isNavActive(href: string): boolean {
  if (href === '/') return here === '/';
  if (href === '/work') return here === '/work' || here.startsWith('/work/');
  return here === href || here.startsWith(href + '/');
}

const isExploreRouteActive =
  here.startsWith('/lab') ||
  here.startsWith('/archive') ||
  here.startsWith('/codex') ||
  here.startsWith('/atlas');
---

<header class="site-header" id="top">
  <a href="/" class="brand-mark" aria-label="Farrel Islami Putra · kembali ke beranda">
    <span class="brand-icon">{DATA.meta.monogram}</span>
    <span class="brand-name">FARREL ISLAMI PUTRA</span>
  </a>

  <nav class="main-nav" aria-label="Navigasi utama">
    {
      NAV.map((item) => {
        const active = isNavActive(item.href);
        return (
          <a
            href={item.href}
            data-nav={item.navKey}
            class:list={['nav-link', { active }]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
    <button
      class:list={['menu-dots', { 'is-active': isExploreRouteActive }]}
      id="menu-dots"
      type="button"
      aria-label="Eksplorasi fitur interaktif dan arsip teknis"
      aria-expanded="false"
      aria-controls="quick-menu"
      data-active={isExploreRouteActive ? 'true' : 'false'}
    >
      <span class="menu-dots-grid" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span class="menu-dots-label">Eksplorasi <em aria-hidden="true">▾</em></span>
    </button>
  </nav>

  <div class="header-actions">
    <!-- V4 §6.5: indikator Now Playing, diisi script dari endpoint Spotify. -->
    <a class="now-playing" id="now-playing" hidden>
      <span class="now-playing-art"><img id="now-playing-img" alt="" width="24" height="24" hidden /></span>
      <span class="now-playing-dot" aria-hidden="true"></span>
      <span class="now-playing-text" id="now-playing-text" aria-live="polite"></span>
    </a>

    <!-- V13.0-D + V14.0 Stage 2.3: Tombol Cari / Pintasan Command Palette -->
    <button
      class="world-status-trigger"
      id="world-workspace-status-btn"
      data-world-trigger="world-status-trigger"
      type="button"
      aria-label="Cari halaman, topik, atau jalankan pintasan (Ctrl+K)"
      aria-haspopup="dialog"
      aria-controls="world-command-dialog"
    >
      <span class="world-status-dot" aria-hidden="true"></span>
      <span class="world-status-friendly">Cari / Pintasan</span>
      <span class="world-status-territory" id="world-status-territory">HOME</span>
      <span class="world-status-state" id="world-status-state" hidden>PALETTE READY</span>
      <kbd class="world-status-kbd" aria-hidden="true">Ctrl+K</kbd>
    </button>

    <!-- V8.0 Fase 2: tombol mute/unmute efek suara antarmuka -->
    <button class="audio-toggle" id="audio-toggle" type="button" aria-label="Mute interface sounds" aria-pressed="false">
      <svg class="audio-icon-on" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4V5z"></path>
        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
      </svg>
      <svg class="audio-icon-off" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
        <path d="M11 5 6 9H2v6h4l5 4V5z"></path>
        <path d="m22 9-6 6M16 9l6 6"></path>
      </svg>
    </button>

    <!-- V7.3 Fase 1: tombol hamburger mobile (<= 980px) -->
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-menu-drawer">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"></path></svg>
    </button>
  </div>

  <!-- V14.0 Stage 2.2: Two-Column Progressive Disclosure Mega-Drawer -->
  <div class="quick-menu" id="quick-menu" role="region" aria-label="Menu eksplorasi dan arsip teknis" hidden>
    <div class="quick-menu-panel" id="quick-menu-panel">
      <!-- Now Playing Row (tetap ada, diisi oleh JS) -->
      <span class="quick-now-playing" id="quick-now-playing" hidden></span>

      <div class="quick-menu-columns">
        <!-- Kolom 1: Explore More -->
        <div class="quick-menu-col" data-drawer-col="explore-more">
          <p class="quick-menu-col-title">EKSPLORASI INTERAKTIF &amp; ARSIP PERSONAL</p>
          <div class="quick-menu-col-links">
            {EXPLORE_INTERACTIVE_ITEMS.map((item) => (
              <a
                href={item.href}
                class:list={['quick-menu-item', { 'is-active': here === item.href }]}
                aria-current={here === item.href ? 'page' : undefined}
              >
                <span class="quick-menu-item-head">
                  <strong class="quick-menu-item-title">{item.label}</strong>
                  <span class="quick-menu-item-badge">{item.badge}</span>
                </span>
                <span class="quick-menu-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Kolom 2: Technical Archive -->
        <div class="quick-menu-col" data-drawer-col="technical-archive">
          <p class="quick-menu-col-title">ARSIP REKAYASA &amp; DOKUMENTASI SISTEM</p>
          <div class="quick-menu-col-links">
            {TECHNICAL_ARCHIVE_ITEMS.map((item) => (
              <a
                href={item.href}
                class:list={['quick-menu-item', { 'is-active': !item.external && here === item.href }]}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                aria-current={!item.external && here === item.href ? 'page' : undefined}
              >
                <span class="quick-menu-item-head">
                  <strong class="quick-menu-item-title">{item.label}</strong>
                  <span class="quick-menu-item-badge">{item.badge}</span>
                </span>
                <span class="quick-menu-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Laci navigasi mobile (<= 980px): 4 item utama + 2 kelompok eksplorasi -->
  <div class="mobile-menu-drawer" id="mobile-menu-drawer" hidden>
    <div class="mobile-menu-inner">
      <div class="mobile-menu-header">
        <span class="brand-icon">{DATA.meta.monogram}</span>
        <button class="mobile-menu-close" id="mobile-menu-close" type="button" aria-label="Tutup menu navigasi">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <nav class="mobile-nav-list" aria-label="Navigasi mobile">
        {NAV.map((item) => {
          const active = isNavActive(item.href);
          return (
            <a
              href={item.href}
              data-nav={item.navKey}
              class:list={['mobile-nav-link', { 'is-active': active }]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}

        <hr class="mobile-menu-divider" />

        <p class="mobile-menu-label">EKSPLORASI INTERAKTIF &amp; ARSIP PERSONAL</p>
        {EXPLORE_INTERACTIVE_ITEMS.map((item) => (
          <a
            href={item.href}
            class:list={['mobile-nav-link mobile-nav-link--deep', { 'is-active': here === item.href }]}
            aria-current={here === item.href ? 'page' : undefined}
          >
            <span class="mobile-nav-deep-copy">
              <strong>{item.label}</strong>
              <small>{item.desc}</small>
            </span>
          </a>
        ))}

        <hr class="mobile-menu-divider" />

        <p class="mobile-menu-label">ARSIP REKAYASA &amp; DOKUMENTASI SISTEM</p>
        {TECHNICAL_ARCHIVE_ITEMS.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="mobile-nav-link mobile-nav-link--deep"
          >
            <span class="mobile-nav-deep-copy">
              <strong>{item.label}</strong>
              <small>{item.desc}</small>
            </span>
            {item.external ? <span class="mobile-nav-ext" aria-hidden="true">↗</span> : null}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
