---
/* ReservedCard: mirror persis reservedCardMarkup() di script.js V6.7.
   Slot reserved: non-clickable, dilabeli jujur, tidak pernah dihitung
   sebagai pekerjaan nyata. Hanya tampil di view All. */
interface Props {
  slot: {
    title: string;
    kicker?: string;
    description?: string;
  };
}

const { slot } = Astro.props;
---

<article class="project-card project-card--reserved" aria-label="Reserved placeholder: no project announced yet">
  <span class="reserved-kicker">{slot.kicker || 'COMING SOON'}</span>
  <h3 class="reserved-title">{slot.title || 'Reserved slot'}</h3>
  <p class="reserved-text">{slot.description || 'A future entry will live here.'}</p>
</article>
